---
/** Entwurf Startseite, Variante 2 „Schriftzug + Zeichnungen“ – noindex, nicht in Sitemap */
import BaseLayout from '../layouts/BaseLayout.astro';
import StartHero from '../components/vorschlag/StartHero.astro';
import Raster from '../components/vorschlag/Raster.astro';
import StartseiteRest from '../components/vorschlag/StartseiteRest.astro';
import { torartKarten, einsatzortKarten } from '../components/vorschlag/daten';

const description =
  'Fußballtore für Verein, Garten und Schule: Professionelle Kaufberatung, Größen-Übersicht und Produktempfehlungen. Finde das passende Fußballtor.';
---

<BaseLayout title="Vorschlag 2: Schriftzug + Zeichnungen" description={description} noindex>
  <StartHero
    hoehe="niedrig"
    title="Fußballtore – Der professionelle Ratgeber"
    subtitle="Kaufberatung, Größen-Übersicht und Produktempfehlungen für Verein, Schule und Garten. Professionell, ehrlich, fundiert."
  >
    <p class="m-0 text-base md:text-lg text-white/80">
      Welches Tor passt zu dir?
      <a href="/torberater/" class="group inline-flex items-center gap-1.5 whitespace-nowrap font-semibold text-accent-light no-underline hover:text-white transition-colors">
        Zum Torberater
        <svg class="w-4 h-4 transition-transform duration-200 ease-out group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </p>
  </StartHero>

  <!-- Torarten (Sortiment) -->
  <section class="py-16 md:py-20" aria-labelledby="nach-torart">
    <div class="container mx-auto">
      <div class="mb-8 max-w-2xl">
        <h2 id="nach-torart" class="font-heading text-2xl md:text-3xl font-bold text-primary mb-2">Fußballtore nach Torart</h2>
        <p class="text-neutral-600 m-0">Die Torart ergibt sich aus Maß und Bauart – unabhängig davon, wo das Tor später steht.</p>
      </div>
      <Raster karten={torartKarten} stil="linie" />
    </div>
  </section>

  <!-- Einsatzorte: welche Torarten passen wohin -->
  <section class="py-16 md:py-20 bg-neutral-50" aria-labelledby="nach-einsatzort">
    <div class="container mx-auto">
      <div class="mb-8 max-w-2xl">
        <h2 id="nach-einsatzort" class="font-heading text-2xl md:text-3xl font-bold text-primary mb-2">Fußballtore nach Einsatzort</h2>
        <p class="text-neutral-600 m-0">An jedem Ort können mehrere Torarten stehen. Die Zeichnungen zeigen die passenden Tore im gleichen Maßstab.</p>
      </div>
      <Raster karten={einsatzortKarten} stil="linie" />
    </div>
  </section>

  <StartseiteRest />
</BaseLayout>
