---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ProductCard from '../components/ProductCard.astro';
import FAQSection from '../components/FAQSection.astro';
import TldrBlock from '../components/TldrBlock.astro';
import RelatedContent from '../components/RelatedContent.astro';
import { addUtm } from '../utils/utm';
import productsData from '../data/products.json';
import pricesData from '../data/prices.json';

// Live-Preise aus dem täglich aktualisierten Preis-Feed (siehe /kaufberatung/)
const priceOf = (id: string): number | null => {
  const product = productsData.products.find((p) => p.id === id);
  const info = product && (pricesData as Record<string, any>)[product.url];
  return info?.price ?? null;
};
const fmtEur = (p: number) =>
  new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(p);
const range = (ids: string[]): string => {
  const ps = ids.map(priceOf).filter((p): p is number => p != null);
  if (!ps.length) return 'Preis beim Anbieter';
  const min = Math.min(...ps);
  const max = Math.max(...ps);
  return min === max ? `${fmtEur(min)} €` : `${fmtEur(min)} – ${fmtEur(max)} €`;
};
const minAll = Math.min(
  ...['popup-set', 'quickplay-150', 'quickplay-180', 'minitor-lightweight', 'minitor-hinterbau']
    .map(priceOf)
    .filter((p): p is number => p != null)
);

const title = 'Minitore & Mini-Fußballtore – Größen, Bauarten, Empfehlungen';
const description = `Mini-Fußballtore im Überblick: alle Größen ab 1,20 × 0,80 m, klappbar oder vollverschweißtes Alu. Echte Preise ab ${fmtEur(minAll)} € und Praxis-Empfehlungen aus dem Fachhandel.`;

const faqs = [
  {
    question: 'Wie groß ist ein Minitor?',
    answer:
      'Das gängigste Maß für Minitore ist 1,20 x 0,80 m – die im Funino-Spielbetrieb übliche Größe. Der DFB schreibt kein festes Maß vor, sondern erlaubt Minitore flexibel bis maximal 2,00 x 1,20 m. Daneben sind 1,50 x 1,00 m und 1,80 x 1,20 m verbreitet, für ältere Kinder gibt es Alu-Minitore bis 2,40 x 1,60 m.',
  },
  {
    question: 'Sind Minitore klappbar?',
    answer:
      'Kunststoff-Minitore wie das QuickPlay Kickster sind klappbar bzw. faltbar und in rund 90 Sekunden aufgebaut – inklusive Tragetasche für den Transport. Alu-Minitore sind dagegen vollverschweißte Einteiler: nicht klappbar, dafür deutlich langlebiger und für den Dauereinsatz im Verein gedacht.',
  },
  {
    question: `Was kostet ein Minitor?`,
    answer: `Pop-up-Tore für den Garten starten bei ${fmtEur(priceOf('popup-set') ?? 0)} € (2er-Set), klappbare Kunststoff-Minitore liegen bei ${range(['quickplay-150', 'quickplay-180'])}. Vollverschweißte Alu-Minitore für den Vereinseinsatz kosten ${range(['minitor-lightweight', 'minitor-hinterbau'])} – je nach Bauart. Die Preise stammen aus dem täglich aktualisierten Feed von anstoss24.de.`,
  },
  {
    question: 'Welche Minitore braucht man für Funino?',
    answer:
      'Der DFB-Standard für Funino sind vier Minitore mit ca. 1,20 x 0,80 m – zwei pro Grundlinie. Für den Vereins-Spielbetrieb empfehlen sich Alu-Minitore (langlebig, TÜV-geprüfte Modelle verfügbar), für Training und Garten reichen klappbare Kunststoff-Tore. Details zum Spielformat findest du in unserem Funino-Ratgeber.',
  },
  {
    question: 'Braucht ein Minitor eine Kippsicherung?',
    answer:
      'Sehr leichte Minitore unter 10 kg – etwa das Alu Minitor Lightweight – benötigen keine Kippsicherung, da von ihnen keine relevante Kippgefahr ausgeht. Leichte Kunststoff-Tore sollten mit den mitgelieferten Erdankern gesichert werden, damit sie bei Wind nicht verrutschen. Schwerere Minitore ab ca. 20 kg stehen durch ihr Eigengewicht und den Bodenrahmen stabil.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: 'https://fussballtore.de/og-minitore.jpg',
    author: {
      '@type': 'Person',
      name: 'Matthias Frank',
      description: 'Tätig im Vereinsbedarf-Fachhandel mit Schwerpunkt Fußballtore',
      url: 'https://fussballtore.de/ueber-uns/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'fussballtore.de',
      url: 'https://fussballtore.de',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': 'https://fussballtore.de/minitore/',
    },
    datePublished: '2026-07-21',
    dateModified: '2026-07-21',
    inLanguage: 'de-DE',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Start',
        item: 'https://fussballtore.de/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Minitore',
        item: 'https://fussballtore.de/minitore/',
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} schema={schema} ogImage="/og-minitore.jpg" ogType="article">
  <HeroSection
    title="Minitore: Die kleinen Fußballtore im Überblick"
    subtitle="Größen, Bauarten und Empfehlungen – vom Pop-up-Tor bis zum Alu-Minitor für den Verein"
    compact
  />
  <Breadcrumb items={[{ label: 'Start', href: '/' }, { label: 'Minitore' }]} />

  <article class="py-12 md:py-16">
    <div class="container mx-auto max-w-4xl">

      <TldrBlock
        title="Minitore — das Wichtigste auf einen Blick"
        items={[
          { label: 'Größen', text: '1,20 × 0,80 m (gängigstes Funino-Maß) bis 2,40 × 1,60 m. Der DFB erlaubt Minitore flexibel bis maximal 2,00 × 1,20 m.' },
          { label: 'Bauarten', text: 'Pop-up (Sekundenaufbau), klappbares Kunststoff-Tor (Garten/Training) oder vollverschweißtes Alu-Minitor (Verein/Dauereinsatz).' },
          { label: 'Einsatz', text: 'Funino (G-/F-Jugend nach DFB-Reform), Techniktraining, Garten, Schulhof.' },
          { label: 'Preis', text: `${fmtEur(minAll)} € (Pop-up-Set) bis ${fmtEur(priceOf('minitor-hinterbau') ?? 0)} € (Alu mit geschlossenem Hinterbau) — Live-Preise von anstoss24.de.` },
          { label: 'Sicherheit', text: 'Unter 10 kg keine Kippsicherung nötig; leichte Tore mit Erdankern gegen Wind sichern.' },
        ]}
        speakableId="tldr-minitore"
      />

      <!-- Direkt-Antworten -->
      <section aria-label="Schnellantworten zu Minitoren" class="mb-4">
        <h2 class="font-heading text-xl md:text-2xl font-bold text-primary mt-10 mb-3">
          Wie groß ist ein Minitor?
        </h2>
        <p class="text-neutral-600 leading-relaxed mb-4">
          Das gängigste Minitor-Maß ist <strong>1,20 m breit und 0,80 m hoch</strong> – die im Funino-Spielbetrieb übliche Größe. Ein festes Standardmaß schreibt der DFB nicht vor: Laut DFB-FAQ zu den Spielformen sind Minitore <strong>flexibel bis maximal 2,00 × 1,20 m</strong> wählbar. Daneben haben sich <strong>1,50 × 1,00 m</strong> und <strong>1,80 × 1,20 m</strong> etabliert; für ältere Kinder und Jugendtraining gibt es Alu-Minitore bis <strong>2,40 × 1,60 m</strong>. Alle übrigen Tormaße findest du in der <a href="/groessen/" class="text-accent hover:text-accent-dark underline underline-offset-2">Größen-Übersicht</a>.
        </p>

        <h2 class="font-heading text-xl md:text-2xl font-bold text-primary mt-10 mb-3">
          Was kostet ein Minitor?
        </h2>
        <p class="text-neutral-600 leading-relaxed mb-4">
          Minitore kosten je nach Bauart zwischen <strong>{fmtEur(minAll)} €</strong> (Pop-up-Set) und <strong>{fmtEur(priceOf('minitor-hinterbau') ?? 0)} €</strong> (vollverschweißtes Alu-Minitor mit geschlossenem Hinterbau). Klappbare Kunststoff-Modelle wie das QuickPlay Kickster liegen bei {range(['quickplay-150', 'quickplay-180'])}, das leichte Alu-Minitor bei {fmtEur(priceOf('minitor-lightweight') ?? 0)} €. Die Preise kommen aus dem täglich aktualisierten Feed des Fachhändlers anstoss24.de.
        </p>
      </section>

      <!-- Größen-Tabelle -->
      <h2 class="font-heading text-xl md:text-2xl font-bold text-primary mt-12 mb-4">
        Minitor-Größen im Überblick
      </h2>
      <p class="text-neutral-600 leading-relaxed mb-6">
        Welche Größe die richtige ist, hängt vom Einsatzzweck und vom Alter der Spieler ab. Die Tabelle zeigt die gängigen Maße und wofür sie sich in der Praxis bewährt haben:
      </p>

      <div class="overflow-x-auto my-8">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-primary text-white">
              <th class="border border-primary px-4 py-3 text-sm text-left font-heading">Größe (B × H)</th>
              <th class="border border-primary px-4 py-3 text-sm text-left font-heading">Typischer Einsatz</th>
              <th class="border border-primary px-4 py-3 text-sm text-left font-heading">Alter (ca.)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white hover:bg-neutral-50 transition-colors">
              <td class="border border-neutral-200 px-4 py-2 text-sm font-medium text-primary">1,20 × 0,80 m</td>
              <td class="border border-neutral-200 px-4 py-2 text-sm text-neutral-600">Funino (gängigstes Maß, 4 Tore pro Feld), Bambini, Garten</td>
              <td class="border border-neutral-200 px-4 py-2 text-sm text-neutral-600">ab 4 Jahre</td>
            </tr>
            <tr class="bg-neutral-50 hover:bg-neutral-100 transition-colors">
              <td class="border border-neutral-200 px-4 py-2 text-sm font-medium text-primary">1,50 × 1,00 m</td>
              <td class="border border-neutral-200 px-4 py-2 text-sm text-neutral-600">Garten, Techniktraining, F-Jugend</td>
              <td class="border border-neutral-200 px-4 py-2 text-sm text-neutral-600">6–9 Jahre</td>
            </tr>
            <tr class="bg-white hover:bg-neutral-50 transition-colors">
              <td class="border border-neutral-200 px-4 py-2 text-sm font-medium text-primary">1,80 × 1,20 m</td>
              <td class="border border-neutral-200 px-4 py-2 text-sm text-neutral-600">Größerer Garten, Trainingsspiele, Schulhof</td>
              <td class="border border-neutral-200 px-4 py-2 text-sm text-neutral-600">8–12 Jahre</td>
            </tr>
            <tr class="bg-neutral-50 hover:bg-neutral-100 transition-colors">
              <td class="border border-neutral-200 px-4 py-2 text-sm font-medium text-primary">2,40 × 1,60 m</td>
              <td class="border border-neutral-200 px-4 py-2 text-sm text-neutral-600">Jugendtraining, Kleinfeld-Varianten</td>
              <td class="border border-neutral-200 px-4 py-2 text-sm text-neutral-600">ab 10 Jahre</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="bg-neutral-50 rounded-xl p-6 md:p-8 my-10">
        <p class="text-neutral-600 leading-relaxed text-sm">
          <strong>DFB-Hintergrund:</strong> Seit der Kinderfußball-Reform (verbindlich ab Saison 2024/2025) spielt die G-Jugend 2-gegen-2 oder 3-gegen-3 auf <strong>vier Minitore</strong> – das Funino-Format. Auch die F-Jugend nutzt Minitore oder 3 × 2 m-Kleinfeldtore. Minitore sind damit offizieller Bestandteil des DFB-Spielbetriebs, nicht nur Trainingsgerät. Alle Details im <a href="/funino/" class="text-accent hover:text-accent-dark underline underline-offset-2">Funino-Ratgeber</a>.
        </p>
      </div>

      <!-- Bauarten -->
      <h2 class="font-heading text-xl md:text-2xl font-bold text-primary mt-12 mb-4">
        Klappbares Minitor oder vollverschweißtes Alu-Tor?
      </h2>
      <p class="text-neutral-600 leading-relaxed mb-4">
        Bei Minitoren gibt es drei Bauarten – und die Wahl entscheidet über Lebensdauer, Aufbauzeit und Preis. Aus der Beratungspraxis: Die häufigste Fehlentscheidung ist ein zu leichtes Tor für den Dauereinsatz.
      </p>

      <h3 class="font-heading text-lg font-bold text-primary mt-8 mb-3">Pop-up-Tore – für spontanes Spielen</h3>
      <p class="text-neutral-600 leading-relaxed mb-4">
        Pop-up-Tore bestehen aus Fiberglas-Stangen mit Polyester-Netz, wiegen nur 1–3 kg und entfalten sich selbst. Perfekt für Garten, Park und Urlaub – aber mit begrenzter Lebensdauer: Bei regelmäßiger Nutzung halten sie erfahrungsgemäß 2–4 Saisons. Für Kinder bis zum Grundschulalter völlig ausreichend.
      </p>

      <h3 class="font-heading text-lg font-bold text-primary mt-8 mb-3">Klappbare Kunststoff-Minitore – der Garten-Allrounder</h3>
      <p class="text-neutral-600 leading-relaxed mb-4">
        Klappbare bzw. faltbare Minitore wie das QuickPlay Kickster sind der Mittelweg: in rund 90 Sekunden aufgebaut, mit Tragetasche transportierbar und dank Erdankern windstabil (das Kickster ist bis über 120 km/h windgetestet). Mit 6–8 kg lassen sie sich von einer Person tragen und nach dem Spielen platzsparend verstauen – der meistgewählte Typ für den <a href="/garten/" class="text-accent hover:text-accent-dark underline underline-offset-2">Garten</a>.
      </p>

      <h3 class="font-heading text-lg font-bold text-primary mt-8 mb-3">Alu-Minitore – für Verein, Schule und Dauereinsatz</h3>
      <p class="text-neutral-600 leading-relaxed mb-4">
        Vollverschweißte Aluminium-Minitore sind Einteiler ohne lösbare Verbindungen – nichts leiert aus, nichts geht verloren. Aluminium rostet nicht und hält 15–25 Jahre. Für den Vereins- und Schulbetrieb gibt es TÜV-geprüfte Modelle mit geschlossenem Hinterbau (Stababstand 86 mm, konform zur Sicherheitsnorm DIN EN 16579). Wer Funino im Spielbetrieb anbietet, kommt an Alu kaum vorbei.
      </p>

      <!-- Produktkarten -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-10">
        <ProductCard
          name="Alu Minitor Lightweight 1,20 x 0,80 m – unter 10 kg"
          url="https://www.anstoss24.de/fussballtore/minitore/aluminium-minitor-lightweight-1-20-x-0-80-m-vollverschweisst_18602_672042/"
          imageUrl="https://cdn02.plentymarkets.com/cmj9dsr9tp66/item/images/18602/full/Aluminium-Minitor-Lightweight-1-20-x-0-80-m-vollverschweisst--18602-Bildschirmfoto-2026-01-15-um-10-19-48.png"
          features={["Unter 10 kg", "Vollverschweißt", "Inkl. Netz", "Komplett Aluminium"]}
          category="Minitore"
          campaign="minitore"
        />
        <ProductCard
          name="QuickPlay Kickster Elite 1,80 x 1,20 m"
          url="https://www.anstoss24.de/tore/quick-play-kickster-1-82m-x-1-21m-fussballtor_47_1030/"
          imageUrl="https://cdn02.plentymarkets.com/cmj9dsr9tp66/item/images/47/secondPreview/QuickPlay-Kickster-Elite-Junior-Minitor-1-80-x-1-20m-47_5.jpg"
          features={["Klappbar", "90-Sek-Aufbau", "Windstabil", "Inkl. Tasche"]}
          category="Minitore"
          campaign="minitore"
        />
      </div>

      <p class="text-neutral-600 leading-relaxed mb-4">
        Das Lightweight-Modell ist mit unter 10 kg das leichteste vollverschweißte Alu-Minitor im Sortiment – so leicht, dass keine Kippsicherung nötig ist, und trotzdem ein Einteiler in Vereinsqualität. Das QuickPlay Kickster gibt es auch kompakter als <a href={addUtm('https://www.anstoss24.de/fussballtore/minitore/quick-play-junior-minitor-1-50-x-1-00m_10078_113668/', 'minitore')} target="_blank" rel="noopener" class="text-accent hover:text-accent-dark underline underline-offset-2">1,50 × 1,00 m-Variante</a>, für spontane Garten-Spiele genügt oft schon ein <a href={addUtm('https://www.anstoss24.de/trainingshilfen/pop-up-goal_19_5098/', 'minitore')} target="_blank" rel="noopener" class="text-accent hover:text-accent-dark underline underline-offset-2">Pop-up-Set</a>.
      </p>

      <!-- Verein/Kommune -->
      <h2 class="font-heading text-xl md:text-2xl font-bold text-primary mt-12 mb-4">
        Minitore für Verein, Schule und Kommune
      </h2>
      <p class="text-neutral-600 leading-relaxed mb-4">
        Im Dauereinsatz gelten andere Maßstäbe als im Garten: Tore bleiben draußen stehen, werden von wechselnden Gruppen genutzt und müssen im Zweifel Vandalismus aushalten. Hier hat sich das Alu-Minitor mit <strong>geschlossenem Hinterbau</strong> bewährt – ohne Netzbügel, an denen sich jemand verletzen oder die verbiegen können.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-10">
        <ProductCard
          name="Alu Minitor 1,20 x 0,80 m – geschlossener Hinterbau, „unzerstörbar“"
          url="https://www.anstoss24.de/fussballtore/minitore/aluminium-minitor-vollverschweisst-mit-geschlossenem-hinterbau-unzerstoerbar_18838_688608/"
          imageUrl="https://cdn02.plentymarkets.com/cmj9dsr9tp66/item/images/18838/full/Aluminium-Minitor-vollverschweisst-mit-geschlossenem-Hinterbau-unzerstoerbar-18838_2.png"
          features={["Geschlossener Hinterbau", "TÜV-geprüft", "Vollverschweißt", "Made in Germany"]}
          category="Minitore"
          campaign="minitore"
        />
        <div class="flex items-center">
          <div class="bg-neutral-50 rounded-xl p-6">
            <h3 class="font-heading text-lg font-bold text-primary mt-0 mb-3">Der Dauerläufer für den Spielbetrieb</h3>
            <p class="text-neutral-600 leading-relaxed mb-3">
              TÜV-geprüft nach DIN EN 16579, Stababstand 86 mm im Hinterbau (unterhalb der 88-mm-Sicherheitsgrenze), 5 Jahre Garantie, Made in Germany. Auch in 1,80 × 1,20 m und 2,40 × 1,60 m erhältlich.
            </p>
            <p class="text-neutral-600 leading-relaxed text-sm">
              Ideal für Vereine mit Funino-Spielbetrieb, Schulhöfe und öffentliche Flächen.
            </p>
          </div>
        </div>
      </div>

      <!-- Sicherheit -->
      <h2 class="font-heading text-xl md:text-2xl font-bold text-primary mt-12 mb-4">
        Sicherheit: Was bei Minitoren wirklich zählt
      </h2>
      <p class="text-neutral-600 leading-relaxed mb-4">
        Die gute Nachricht: Von leichten Minitoren geht deutlich weniger Gefahr aus als von großen Toren. Sehr leichte Modelle unter 10 kg brauchen <strong>keine Kippsicherung</strong>. Trotzdem gilt:
      </p>
      <ul class="list-disc list-inside space-y-2 text-neutral-600 leading-relaxed mb-4 ml-2">
        <li><strong>Leichte Kunststoff-Tore</strong> mit den mitgelieferten Erdankern sichern – nicht wegen Kippgefahr, sondern damit sie bei Wind nicht durch den Garten fliegen.</li>
        <li><strong>Klettern verboten:</strong> Auch am Minitor gilt die Grundregel für alle <a href="/kinder/" class="text-accent hover:text-accent-dark underline underline-offset-2">Kindertore</a> – Tore sind kein Klettergerüst.</li>
        <li><strong>Öffentlicher Raum:</strong> Für Schulen und Kommunen empfehlen sich TÜV-geprüfte Modelle nach DIN EN 16579 – im Schadensfall haftet der Betreiber.</li>
        <li><strong>Aufbau:</strong> Schritt-für-Schritt-Anleitungen für alle Bauarten findest du in der <a href="/aufbau-anleitung/" class="text-accent hover:text-accent-dark underline underline-offset-2">Aufbau-Anleitung</a>.</li>
      </ul>

      <!-- Fazit -->
      <h2 class="font-heading text-xl md:text-2xl font-bold text-primary mt-12 mb-4">
        Fazit: Welches Minitor passt zu dir?
      </h2>
      <p class="text-neutral-600 leading-relaxed mb-4">
        Für <strong>spontanes Spielen im Garten</strong> reicht ein Pop-up-Set, für <strong>regelmäßiges Spielen und Training</strong> ist ein klappbares Kunststoff-Tor wie das QuickPlay die beste Balance aus Preis und Stabilität. Sobald das Tor <strong>dauerhaft draußen steht</strong> oder im Verein genutzt wird, lohnt sich der Schritt zum vollverschweißten Alu-Minitor – es kostet mehr, hält dafür aber 15–25 Jahre statt weniger Saisons.
      </p>
      <p class="text-neutral-600 leading-relaxed mb-4">
        Alle Minitore mit aktuellen Preisen findest du in der <a href={addUtm('https://www.anstoss24.de/fussballtore/minitore/', 'minitore')} target="_blank" rel="noopener" class="text-accent hover:text-accent-dark underline underline-offset-2">Minitore-Übersicht bei anstoss24.de</a>. Und falls du noch unsicher bei der Größe bist: Die <a href="/groessen/" class="text-accent hover:text-accent-dark underline underline-offset-2">Größen-Übersicht</a> ordnet alle Tormaße nach Altersklasse ein.
      </p>

      <RelatedContent
        items={[
          { href: '/funino/', title: 'Funino-Tore', subtitle: 'Das DFB-Spielformat 3-gegen-3' },
          { href: '/kinder/', title: 'Kindertore', subtitle: 'Altersgerechte Tore von 3 bis 14' },
          { href: '/garten/', title: 'Gartentore', subtitle: 'Pop-up, Steck & Mini für zuhause' },
          { href: '/groessen/', title: 'Größen & Maße', subtitle: 'Alle Tormaße nach Altersklasse' },
        ]}
      />

    </div>
  </article>

  <!-- FAQ Section -->
  <div class="bg-neutral-50">
    <div class="container mx-auto max-w-4xl">
      <FAQSection faqs={faqs} title="Häufige Fragen zu Minitoren" />
    </div>
  </div>
</BaseLayout>
