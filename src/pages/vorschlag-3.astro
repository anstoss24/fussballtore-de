---
/** Entwurf Startseite, Variante 3 „Ein Block mit Umschalter“ – noindex, nicht in Sitemap */
import BaseLayout from '../layouts/BaseLayout.astro';
import StartHero from '../components/vorschlag/StartHero.astro';
import Umschalter from '../components/vorschlag/Umschalter.astro';
import TorberaterTeaser from '../components/TorberaterTeaser.astro';
import StartseiteRest from '../components/vorschlag/StartseiteRest.astro';

const description =
  'Fußballtore für Verein, Garten und Schule: Professionelle Kaufberatung, Größen-Übersicht und Produktempfehlungen. Finde das passende Fußballtor.';
---

<BaseLayout title="Vorschlag 3: Ein Block mit Umschalter" description={description} noindex>
  <StartHero
    hoehe="mittel"
    title="Fußballtore – Der professionelle Ratgeber"
    subtitle="Kaufberatung, Größen-Übersicht und Produktempfehlungen für Verein, Schule und Garten. Professionell, ehrlich, fundiert."
  />

  <Umschalter />

  <!-- Torberater-Band: bestehender Teaser, Text unverändert -->
  <div class="container mx-auto -mt-4 pb-16 md:-mt-8 md:pb-20 [&>aside]:mt-0">
    <TorberaterTeaser title="Unsicher, welches Tor?" />
  </div>

  <StartseiteRest />
</BaseLayout>
