---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ProductCard from '../components/ProductCard.astro';
import FAQSection from '../components/FAQSection.astro';
import TldrBlock from '../components/TldrBlock.astro';
import RelatedContent from '../components/RelatedContent.astro';
import { addUtm } from '../utils/utm';
import productsData from '../data/products.json';
import pricesData from '../data/prices.json';
import { AUTHOR, PUBLISHER } from '../data/entities';
import pageDates from '../data/page-dates.json';
const dateModified = pageDates['tornetz'];

// Live-Preis aus dem täglich aktualisierten Preis-Feed
const priceOf = (id: string): number | null => {
  const product = productsData.products.find((p) => p.id === id);
  const info = product && (pricesData as Record<string, any>)[product.url];
  return info?.price ?? null;
};
const fmtEur = (p: number) =>
  new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(p);
const netzPreis = priceOf('tornetz-grossfeld');

const title = 'Tornetz: Welches Netz für welches Fußballtor?';
const description =
  `Tornetz richtig wählen: Großfeld, Jugend, Kleinfeld oder Minitor – Garnstärke, Maschenweite und Netztiefe im Überblick.${netzPreis ? ` Großfeld-Netz ab ${fmtEur(netzPreis)} €.` : ''}`;

const faqs = [
  {
    question: 'Welches Tornetz für ein Großfeldtor (7,32 × 2,44 m)?',
    answer:
      'Für Großfeldtore empfehlen wir ein knotenloses Netz aus hochfestem Polypropylen (PP) mit 4 mm Stärke und 12 cm Maschenweite. Die Netztiefe ist wählbar: 0,80 / 1,50 m, 0,80 / 2,00 m oder 2,00 / 2,00 m (oben / unten). Wer Wabenoptik möchte, nimmt die Variante mit wabenförmigen Maschen in 3,5 mm.',
  },
  {
    question: 'Was kostet ein Tornetz?',
    answer: `Ein Vereins-Tornetz für Großfeldtore (PP, 4 mm, 12er-Masche) kostet aktuell ${netzPreis ? fmtEur(netzPreis) + ' €' : 'unter 100 €'} pro Stück — der Preis stammt aus dem täglich aktualisierten Feed von anstoss24.de. Die Preise der Netze für Jugend-, Kleinfeld- und Minitore findest du direkt im Shop.`,
  },
  {
    question: 'Welches Tornetz passt auf ein 3 x 2 m Tor?',
    answer: 'Für Kleinfeld-, Futsal- und Bolzplatztore (3,00 x 2,00 m) gibt es ein eigenes Netz: Polypropylen, knotenlos, 4 mm Stärke, 10 cm Maschenweite. Die Netztiefe beträgt oben 0,80 m und unten 1,00 oder 1,50 m. Wichtig: Das Netz muss zur Tortiefe deines Tors passen — miss vor der Bestellung nach.',
  },
  {
    question: 'Aus welchem Material ist ein gutes Tornetz?',
    answer:
      'Aus hochfestem Polypropylen (PP). Es ist langlebig, witterungsbeständig und UV-stabil. Alle Vereinsnetze im Fachhandel von anstoss24 – vom Minitor- bis zum Großfeldnetz – sind aus PP gefertigt, knotenlos verarbeitet und haben eine verstärkte Netzumrandung.',
  },
  {
    question: 'Wann muss ein Tornetz gewechselt werden?',
    answer:
      'Eine feste Laufzeit gibt es nicht. Prüfe das Netz vor jeder Nutzung: Sind Maschen gerissen oder hat sich die Umrandung gelöst, wird es Zeit für ein neues.',
  },
  {
    question: 'Was ist die richtige Maschenweite?',
    answer:
      'Für Großfeld- und Jugendtore sind 12 cm Standard, für Kleinfeld- und Bolzplatztore 10 cm. Netze für Minitore gibt es mit 4,5 oder 10 cm Maschenweite. Für Großfeldtore gibt es neben quadratischen auch wabenförmige Maschen. Wichtiger als die Maschenform ist die Verarbeitung: Knotenlose Netze verschleißen deutlich weniger als geknotete, weil die Maschenverbindungen nicht aneinander scheuern.',
  },
  {
    question: 'Wie viele Löcher hat ein Tornetz?',
    answer:
      'Eine feste Zahl gibt es nicht – sie ergibt sich aus Maschenweite und Netzgröße. Tornetze für Großfeld- und Jugendtore haben 12 cm Maschenweite, Netze für Kleinfeld- und Bolzplatztore 10 cm, Netze für Minitore 4,5 oder 10 cm. Für den Kauf zählt nicht die Maschenzahl, sondern dass Tormaß, Netztiefe und Maschenweite zum Tor passen.',
  },
  {
    question: 'Brauche ich ein Ersatznetz oder nur das passende?',
    answer:
      'Für Vereine mit mehreren Toren lohnt sich ein Ersatznetz im Lager: Fällt ein Netz aus, ist das Tor sofort wieder einsatzbereit.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: 'https://fussballtore.de/og-tornetz.jpg',
    datePublished: '2026-05-20',
    dateModified,
    inLanguage: 'de-DE',
    author: AUTHOR,
    publisher: PUBLISHER,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': 'https://fussballtore.de/tornetz/',
    },
  },
];
---

<BaseLayout title={title} description={description} schema={schema} ogImage="/og-tornetz.jpg" ogType="article">
  <HeroSection
    title="Tornetz für Fußballtore"
    subtitle="Material, Stärke, Maschenweite — so wählst du das richtige Netz"
    compact
  />
  <Breadcrumb modified={dateModified} items={[{ label: 'Start', href: '/' }, { label: 'Tornetz' }]} />

  <article class="container mx-auto max-w-4xl py-12 md:py-16">

    <TldrBlock
      title="Tornetz auf einen Blick"
      items={[
        { label: 'Material', text: 'Hochfestes Polypropylen (PP): langlebig, witterungsbeständig, UV-stabil.' },
        { label: 'Garnstärke', text: '4 mm für Großfeld-, Jugend- und Kleinfeldtore, 3,5 mm beim Großfeldnetz mit Wabenmaschen, 2,3 oder 3,0 mm für Minitore.' },
        { label: 'Maschenweite', text: '12 cm bei Großfeld- und Jugendtoren, 10 cm bei Kleinfeldtoren, 4,5 oder 10 cm bei Minitoren. Knotenlose Netze verschleißen weniger als geknotete.' },
        { label: 'Netztiefe Großfeld', text: 'Oben 80 cm, unten 200 cm — damit der Ball sauber ins Netz fällt.' },
        { label: 'Verarbeitung', text: 'Knotenlos mit verstärkter Netzumrandung. Sichtprüfung vor jeder Nutzung.' },
      ]}
      speakableId="tldr-tornetz"
    />

    <!-- Einleitung -->
    <p class="text-lg md:text-xl text-neutral-700 leading-relaxed mb-6">
      Ohne Netz kein richtiges Tor. Aber welches <strong>Tornetz</strong> passt zu deinem Fußballtor — und wie unterscheidet sich ein 4-mm-Vereinsnetz von einem dünnen Pop-up-Netz? Wir erklären die wichtigsten Kriterien, damit du nicht zweimal kaufst.
    </p>

    <!-- Direkt-Antwort: Zuordnung -->
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary mt-12 mb-4">
      Welches Tornetz für welches Tor?
    </h2>
    <p class="text-neutral-600 leading-relaxed mb-4">
      Die Netz-Wahl richtet sich nach dem <strong>Tormaß</strong> und der <strong>Tortiefe</strong> deines Tors. Die Übersicht zeigt, welche Netze es für die gängigen Torgrößen im Fachhandel gibt:
    </p>

    <div class="overflow-x-auto my-8">
      <table class="w-full text-sm text-left border border-neutral-200 rounded-lg overflow-hidden">
        <thead class="bg-neutral-50">
          <tr>
            <th class="px-4 py-3 font-heading font-bold text-primary">Tor</th>
            <th class="px-4 py-3 font-heading font-bold text-primary">Netztiefe (oben/unten)</th>
            <th class="px-4 py-3 font-heading font-bold text-primary">Garnstärke</th>
            <th class="px-4 py-3 font-heading font-bold text-primary">Maschenweite</th>
          </tr>
        </thead>
        <tbody class="text-neutral-600">
          <tr class="border-t border-neutral-200">
            <td class="px-4 py-3 font-medium">Großfeldtor (7,32 × 2,44 m)</td>
            <td class="px-4 py-3">80 / 150, 80 / 200 oder 200 / 200 cm</td>
            <td class="px-4 py-3">4 mm (Wabenmasche: 3,5 mm)</td>
            <td class="px-4 py-3">12 cm</td>
          </tr>
          <tr class="border-t border-neutral-200 bg-neutral-50/50">
            <td class="px-4 py-3 font-medium">Jugendtor (5,00 × 2,00 m)</td>
            <td class="px-4 py-3">100 / 100, 80 / 150 oder 90 / 200 cm</td>
            <td class="px-4 py-3">4 mm</td>
            <td class="px-4 py-3">12 cm</td>
          </tr>
          <tr class="border-t border-neutral-200">
            <td class="px-4 py-3 font-medium">Kleinfeld-/Bolzplatztor (3,00 × 2,00 m)</td>
            <td class="px-4 py-3">80 / 100 oder 80 / 150 cm</td>
            <td class="px-4 py-3">4 mm</td>
            <td class="px-4 py-3">10 cm</td>
          </tr>
          <tr class="border-t border-neutral-200 bg-neutral-50/50">
            <td class="px-4 py-3 font-medium">Minitor (1,20 × 0,80 / 1,80 × 1,20 / 2,40 × 1,60 m)</td>
            <td class="px-4 py-3">passend zur Torgröße</td>
            <td class="px-4 py-3">2,3 oder 3,0 mm</td>
            <td class="px-4 py-3">4,5 oder 10 cm</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-neutral-600 leading-relaxed mb-4">
      Wichtig: Miss vor der Bestellung die Tortiefe deines Tors (oben und unten), damit die Netzform passt. Alle Tormaße im Detail: <a href="/groessen/" class="text-accent hover:text-accent-dark transition-colors font-medium">Größen-Übersicht</a>.
    </p>

    <!-- Material -->
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary mt-12 mb-4">
      Material: hochfestes Polypropylen
    </h2>
    <p class="text-neutral-600 leading-relaxed mb-4">
      Vereinsnetze sind aus <strong>hochfestem Polypropylen (PP)</strong> gefertigt. Das Material ist langlebig, witterungsbeständig und UV-stabil. Großfeld- und Jugendnetze gibt es in vielen Farben und Farbkombinationen passend zu den Vereinsfarben, Kleinfeldnetze in Grün, Weiß und Gelb, Minitornetze in Grün und Blau.
    </p>

    <!-- Garnstärke -->
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary mt-12 mb-4">
      Garnstärke: welches Netz wie dick?
    </h2>
    <p class="text-neutral-600 leading-relaxed mb-4">
      Die Garnstärke richtet sich nach der Torgröße. Die Vereinsnetze im Fachhandel im Überblick:
    </p>

    <div class="overflow-x-auto my-8">
      <table class="w-full text-sm text-left border border-neutral-200 rounded-lg overflow-hidden">
        <thead class="bg-neutral-50">
          <tr>
            <th class="px-4 py-3 font-heading font-bold text-primary">Netz</th>
            <th class="px-4 py-3 font-heading font-bold text-primary">Stärke</th>
            <th class="px-4 py-3 font-heading font-bold text-primary">Maschenweite</th>
          </tr>
        </thead>
        <tbody class="text-neutral-600">
          <tr class="border-t border-neutral-200">
            <td class="px-4 py-3 font-medium">Großfeldtor 7,32 × 2,44 m</td>
            <td class="px-4 py-3">4 mm</td>
            <td class="px-4 py-3">12 cm</td>
          </tr>
          <tr class="border-t border-neutral-200 bg-neutral-50/50">
            <td class="px-4 py-3 font-medium">Großfeldtor, wabenförmige Maschen</td>
            <td class="px-4 py-3">3,5 mm</td>
            <td class="px-4 py-3">12 cm</td>
          </tr>
          <tr class="border-t border-neutral-200">
            <td class="px-4 py-3 font-medium">Jugendtor 5,00 × 2,00 m</td>
            <td class="px-4 py-3">4 mm</td>
            <td class="px-4 py-3">12 cm</td>
          </tr>
          <tr class="border-t border-neutral-200 bg-neutral-50/50">
            <td class="px-4 py-3 font-medium">Kleinfeld-, Futsal- und Bolzplatztor 3,00 × 2,00 m</td>
            <td class="px-4 py-3">4 mm</td>
            <td class="px-4 py-3">10 cm</td>
          </tr>
          <tr class="border-t border-neutral-200">
            <td class="px-4 py-3 font-medium">Minitore</td>
            <td class="px-4 py-3">2,3 oder 3,0 mm</td>
            <td class="px-4 py-3">4,5 oder 10 cm</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Maschenweite -->
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary mt-12 mb-4">
      Maschenweite und Verarbeitung: knotenlos oder geknotet?
    </h2>
    <p class="text-neutral-600 leading-relaxed mb-4">
      Die Standardmaschenweite für Großfeld- und Jugendtore beträgt <strong>12 cm</strong>, für Kleinfeld- und Bolzplatztore <strong>10 cm</strong>. Das ist eng genug, damit der Ball sicher zurückgehalten wird — und weit genug, damit das Netz nicht unnötig schwer wird. Netze für <a href="/minitore/" class="text-accent hover:text-accent-dark transition-colors font-medium">Minitore</a> gibt es mit <strong>4,5 oder 10 cm</strong> Maschenweite. Für Großfeldtore gibt es neben quadratischen auch <strong>wabenförmige Maschen</strong>. Beim Garn unterscheidet man zwei Verarbeitungen:
    </p>
    <ul class="space-y-3 text-neutral-600 leading-relaxed mb-6">
      <li class="flex items-start gap-3">
        <span class="inline-block w-2 h-2 rounded-full bg-accent mt-2.5 flex-shrink-0"></span>
        <span><strong>Geknotet:</strong> Die Maschen sind an den Kreuzungspunkten verknotet. Die klassische Bauweise — die Knoten scheuern aber bei jedem Torschuss aneinander.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="inline-block w-2 h-2 rounded-full bg-accent mt-2.5 flex-shrink-0"></span>
        <span><strong>Knotenlos (gewirkt):</strong> Die Maschen sind ohne Knoten verbunden. Die Energie des Torschusses wird materialschonend gedämpft, nichts scheuert — der Verschleiß ist deutlich geringer. So sind die 4-mm-Vereinsnetze im Fachhandel gefertigt, wie sie auch in der Bundesliga hängen.</span>
      </li>
    </ul>
    <p class="text-neutral-600 leading-relaxed mb-4">
      Dazu kommt eine <strong>verstärkte Netzumrandung</strong>: Sie verhindert, dass das Netz aus den Netzhaken reißt, und macht die Abschlusskanten deutlich robuster.
    </p>

    <!-- Netztiefe -->
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary mt-12 mb-4">
      Netztiefe: Damit der Ball nicht zurückrollt
    </h2>
    <p class="text-neutral-600 leading-relaxed mb-4">
      Die Tortiefe entscheidet, wie schön der Torjubel ausfällt. Zu flache Netze lassen den Ball nach dem Tor sofort wieder herauskullern. Zu tiefe Netze sind teurer und schwerer zu spannen. Bewährte Maße:
    </p>

    <div class="overflow-x-auto my-8">
      <table class="w-full text-sm text-left border border-neutral-200 rounded-lg overflow-hidden">
        <thead class="bg-neutral-50">
          <tr>
            <th class="px-4 py-3 font-heading font-bold text-primary">Tortyp</th>
            <th class="px-4 py-3 font-heading font-bold text-primary">Tortiefe oben</th>
            <th class="px-4 py-3 font-heading font-bold text-primary">Tortiefe unten</th>
          </tr>
        </thead>
        <tbody class="text-neutral-600">
          <tr class="border-t border-neutral-200">
            <td class="px-4 py-3 font-medium">Großfeld (7,32 × 2,44 m)</td>
            <td class="px-4 py-3">80 cm</td>
            <td class="px-4 py-3">200 cm</td>
          </tr>
          <tr class="border-t border-neutral-200 bg-neutral-50/50">
            <td class="px-4 py-3 font-medium">Jugend (5 × 2 m)</td>
            <td class="px-4 py-3">80 cm</td>
            <td class="px-4 py-3">150 cm</td>
          </tr>
          <tr class="border-t border-neutral-200">
            <td class="px-4 py-3 font-medium">Kleinfeld (3 × 2 m)</td>
            <td class="px-4 py-3">80 cm</td>
            <td class="px-4 py-3">100 cm</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-neutral-600 leading-relaxed mb-4">
      Mehr zu den Tor-Größen findest du in unserer <a href="/groessen/" class="text-accent hover:text-accent-dark transition-colors font-medium">Größen-Übersicht</a>.
    </p>

    <!-- Produkt -->
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary mt-12 mb-4">
      Unsere Empfehlung für ein gutes Vereinsnetz
    </h2>
    <p class="text-neutral-600 leading-relaxed mb-8">
      Ein bewährtes Großfeld-Netz mit gutem Preis-Leistungs-Verhältnis:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      <div>
        <ProductCard
          name="Tornetz für Großfeldtore – Stärke 4 mm"
          url="https://www.anstoss24.de/fussballtore/tornetze/tornetz-fuer-grossfeldtore-staerke-4-mm_617025_1055254/"
          imageUrl="https://cdn02.plentyone.com/cmj9dsr9tp66/item/images/617025/full/Tornetz-fuer-Grossfeldtore-Staerke-4-mm-617025-Tornetz-fuer-Grossfeldtore-Staerke-4-mm-25-1.jpg"
          features={['Polypropylen', '4 mm, knotenlos', 'Maschenweite 12 cm', 'Farbwahl']}
          category="Tornetz Großfeld"
          campaign="tornetz"
        />
      </div>
      <div class="flex items-center">
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="font-heading text-lg font-bold text-primary mt-0 mb-3">Das Standard-Netz für Vereine</h3>
          <p class="text-neutral-600 leading-relaxed mb-3">
            Polypropylen hochfest, 4 mm, knotenlos, Maschenweite 12 cm. Netztiefe wählbar — zum Beispiel 80 cm oben und 200 cm unten. In vielen Farben und Farbkombinationen, passend zu deinen Vereinsfarben.
          </p>
        </div>
      </div>
    </div>

    <!-- Pflege -->
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary mt-12 mb-4">
      Pflege: So bleibt dein Netz in Form
    </h2>
    <ul class="space-y-3 text-neutral-600 leading-relaxed mb-6">
      <li class="flex items-start gap-3">
        <span class="inline-block w-2 h-2 rounded-full bg-accent mt-2.5 flex-shrink-0"></span>
        <span><strong>Außerhalb der Saison abnehmen.</strong> Wird das Tor über den Winter nicht genutzt, nimm das Netz ab und lagere es trocken.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="inline-block w-2 h-2 rounded-full bg-accent mt-2.5 flex-shrink-0"></span>
        <span><strong>Vor jeder Nutzung Sichtprüfung.</strong> Gerissene Maschen verschlimmern sich schnell — frühzeitig reparieren oder ersetzen.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="inline-block w-2 h-2 rounded-full bg-accent mt-2.5 flex-shrink-0"></span>
        <span><strong>Bei Sturm abnehmen.</strong> Ein gespanntes Netz bietet dem Wind eine große Angriffsfläche. Bei orkanartigen Böen kann sogar das Tor kippen.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="inline-block w-2 h-2 rounded-full bg-accent mt-2.5 flex-shrink-0"></span>
        <span><strong>Sauber lagern.</strong> Vor der Lagerung Schmutz und Erde mit dem Schlauch abspritzen und das Netz trocknen lassen.</span>
      </li>
    </ul>

    <!-- Fazit -->
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary mt-12 mb-4">
      Fazit: Beim Netz lohnt sich Qualität
    </h2>
    <p class="text-neutral-600 leading-relaxed mb-4">
      Ein gutes Tornetz ist nicht teuer — ein schlechtes wird teuer. Wir empfehlen für den Vereinsbetrieb <strong>knotenlose PP-Netze in 4 mm Stärke</strong>, mit 12 cm Maschenweite für Großfeld- und Jugendtore und 10 cm für Kleinfeldtore.
    </p>
    <p class="text-neutral-600 leading-relaxed mb-4">
      Für Bolzplätze und vandalismusgefährdete Standorte gibt es vollverschweißte Kleinfeldtore mit Herkulesnetz und Netzaufhängung mit Stangensystem. Mehr dazu findest du im <a href="/bolzplatztor/" class="text-accent hover:text-accent-dark transition-colors font-medium">Bolzplatztor-Ratgeber</a>.
    </p>

    <RelatedContent
      items={[
        { href: '/verein/', title: 'Vereinstore', subtitle: 'Wettkampftore nach DIN' },
        { href: '/groessen/', title: 'Größen & Maße', subtitle: 'Welches Netz für welche Größe' },
        { href: '/bolzplatztor/', title: 'Bolzplatztor', subtitle: 'Vandalismussicher' },
        { href: '/material-vergleich/', title: 'Material', subtitle: 'Alu vs. Kunststoff' },
      ]}
    />
  </article>

  <!-- FAQ -->
  <div class="bg-neutral-50">
    <div class="container mx-auto max-w-4xl">
      <FAQSection faqs={faqs} title="Häufige Fragen zu Tornetzen" />
    </div>
  </div>
</BaseLayout>
