---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import CategoryCard from '../components/CategoryCard.astro';
import TorLinien from '../components/TorLinien.astro';
import { TORARTEN, TORART_REIHENFOLGE, EINSATZORTE } from '../data/einsatzorte';
import ProductCard from '../components/ProductCard.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FAQSection from '../components/FAQSection.astro';
import TorberaterEinstieg from '../components/TorberaterEinstieg.astro';
import { features } from '../data/features';
import { addUtm } from '../utils/utm';
import productsData from '../data/products.json';
import { PUBLISHER } from '../data/entities';
import pageDates from '../data/page-dates.json';
const dateModified = pageDates['index'];

const title = 'Fußballtore – Der professionelle Ratgeber';
const description =
  'Fußballtore für Verein, Garten und Schule: Professionelle Kaufberatung, Größen-Übersicht und Produktempfehlungen. Finde das passende Fußballtor.';

// Zwei Logiken: Torarten (Sortiment) und Einsatzorte (wo das Tor steht) – Daten in src/data/einsatzorte.ts
const torarten = TORART_REIHENFOLGE.map((id) => TORARTEN[id]);
// Gemeinsamer Maßstab für alle Einsatzort-Zeilen: so breit wie die längste Torreihe
const reiheM = Math.max(...EINSATZORTE.map((e) => e.tore.reduce((s, z) => s + TORARTEN[z.torart].breite + 0.9, 0.3)));

// Pick 3 highlight products from different categories
const findProduct = (id) => productsData.products.find(p => p.id === id);

const highlightProducts = [
  { ...findProduct('bundesliga-premium'), category: 'Großfeldtore' },
  { ...findProduct('minitor-lightweight'), category: 'Minitore' },
  { ...findProduct('bolzplatz-unkaputtbar'), category: 'Bolzplatztore' },
];

const faqs = [
  {
    question: 'Welche Fußballtor-Größe brauche ich?',
    answer:
      'Die Größe hängt vom Einsatzzweck ab: Wettkampf-Großfeldtore sind 7,32 x 2,44 m, Jugendtore 5,00 x 2,00 m. Für den Garten reichen Minitore ab 1,20 x 0,80 m. In unserer Größen-Übersicht findest du alle Maße im Detail.',
  },
  {
    question: 'Was kostet ein gutes Fußballtor?',
    answer:
      'Die Preisspanne ist groß: Pop-up-Tore für den Garten gibt es für kleines Geld, klappbare Garten-Minitore im zweistelligen und vollverschweißte Alu-Minitore im dreistelligen Bereich. Jugend- und Großfeldtore aus Aluminium liegen im hohen drei- bis vierstelligen Bereich, robuste Bolzplatztore sind die teuerste Kategorie. Tagesaktuelle Preise findest du in unserer Kaufberatung und im Torberater.',
  },
  {
    question: 'Alu oder Kunststoff – welches Material ist besser?',
    answer:
      'Aluminium ist leicht, rostfrei und langlebig – der Standard für Vereine und dauerhafte Installation. Kunststoff und Fiberglas sind günstiger und ultraleicht, eignen sich aber nur für Minitore im Garten. Mehr dazu in unserem Material-Vergleich.',
  },
  {
    question: 'Müssen Fußballtore TÜV-geprüft sein?',
    answer:
      'Für Verein, Schule und Kommune ja: Der Betreiber hat die Verkehrssicherungspflicht, Maßstab dafür ist die DIN EN 748 mit ihren Anforderungen an Standsicherheit und Kippsicherung. Ein Prüfzeichen einer unabhängigen Stelle wie dem TÜV weist diese Konformität nach. Im privaten Garten gibt es keine Pflicht, geprüfte Tore bieten aber mehr Sicherheit – gerade wenn Kinder damit spielen.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'fussballtore.de',
    url: 'https://fussballtore.de',
    description,
    inLanguage: 'de-DE',
  },
  { '@context': 'https://schema.org', ...PUBLISHER },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Hero -->
  {features.torberater ? (
    <HeroSection
      title="Fußballtore – Der professionelle Ratgeber"
      subtitle="Kaufberatung, Größen-Übersicht und Produktempfehlungen für Verein, Schule und Garten. Professionell, ehrlich, fundiert."
    >
      <TorberaterEinstieg />
    </HeroSection>
  ) : (
    <HeroSection
      title="Fußballtore – Der professionelle Ratgeber"
      subtitle="Kaufberatung, Größen-Übersicht und Produktempfehlungen für Verein, Schule und Garten. Professionell, ehrlich, fundiert."
      ctaText="Zur Kaufberatung"
      ctaHref="/kaufberatung/"
    />
  )}

  <!-- Torarten (Sortiment) -->
  <section class="py-16 md:py-20" aria-labelledby="nach-torart">
    <div class="container mx-auto">
      <div class="mb-8 max-w-2xl">
        <h2 id="nach-torart" class="font-heading text-2xl md:text-3xl font-bold text-primary mb-2">
          Fußballtore nach Torart
        </h2>
        <p class="text-neutral-600 m-0">Die Torart ergibt sich aus Maß und Bauart – unabhängig davon, wo das Tor später steht.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-4 md:gap-5">
        {torarten.map((t, i) => (
          <CategoryCard
            name={t.plural.replaceAll('-', '\u2011') /* geschützte Bindestriche: kein Umbruch in „Pop-up“ */}
            meta={t.mass}
            subtitle={t.subtitle}
            href={t.href}
            image={t.foto}
            wide={i === torarten.length - 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Einsatzorte: welche Torarten passen wohin -->
  <section class="py-16 md:py-20 bg-neutral-50" aria-labelledby="nach-einsatzort">
    <div class="container mx-auto">
      <div class="mb-8 max-w-2xl">
        <h2 id="nach-einsatzort" class="font-heading text-2xl md:text-3xl font-bold text-primary mb-2">
          Fußballtore nach Einsatzort
        </h2>
        <p class="text-neutral-600 m-0">An jedem Ort können mehrere Torarten stehen. Die Zeichnungen zeigen die passenden Tore im gleichen Maßstab.</p>
      </div>
      <ul class="divide-y divide-neutral-200 border-y border-neutral-200 list-none p-0 m-0">
        {EINSATZORTE.map((e) => (
          <li class="m-0 p-0">
            <a
              href={e.href}
              class="group grid grid-cols-[minmax(0,1fr)_auto] md:grid-cols-[13rem_minmax(0,1fr)_17rem_auto] lg:grid-cols-[15rem_minmax(0,1fr)_22rem_auto] items-center gap-x-6 gap-y-3 py-5 md:py-6 no-underline"
            >
              <span class="min-w-0">
                <span class="block font-heading text-lg md:text-xl font-bold text-primary group-hover:text-accent-dark transition-colors">{e.name}</span>
                <span class="block text-sm text-neutral-500 leading-snug">{e.subtitle}</span>
              </span>
              <span class="col-span-2 row-start-2 md:col-span-1 md:row-start-auto text-sm text-neutral-600 leading-snug">
                <span class="font-semibold text-primary">Geeignet:</span>{' '}
                {e.tore.map((z) => TORARTEN[z.torart].plural).join(' · ')}
              </span>
              <span class="col-span-2 row-start-3 md:col-span-1 md:row-start-auto text-accent-dark">
                <TorLinien tore={e.tore.map((z) => z.torart)} breiteM={reiheM} class="block h-auto w-full" />
              </span>
              <svg class="row-start-1 col-start-2 md:row-start-auto md:col-start-auto h-5 w-5 flex-none text-neutral-400 transition-[transform,color] duration-200 ease-out group-hover:translate-x-1 group-hover:text-accent-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Product Highlights -->
  <section class="py-16 md:py-20">
    <div class="container mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary mb-3">
        Beliebte Fußballtore
      </h2>
      <p class="text-neutral-600 mb-8 max-w-2xl">
        Ausgewählte Tore von Fachhändlern für Vereinsbedarf. TÜV-geprüft, Made in Germany.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {highlightProducts.map((product) => (
          <ProductCard
            name={product.name}
            url={product.url}
            imageUrl={product.imageUrl}
            features={product.features}
            category={product.category}
            campaign="startseite"
          />
        ))}
      </div>
      <div class="text-center mt-10">
        <a
          href={addUtm('https://www.anstoss24.de/fussballtore/', 'startseite')}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-accent-dark font-semibold hover:text-accent transition-colors"
        >
          Alle Fußballtore im Shop
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- Intro Text (SEO) -->
  <section class="py-16 md:py-20">
    <div class="container mx-auto max-w-4xl">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary mb-6">
        Dein Ratgeber für Fußballtore
      </h2>
      <div class="prose text-neutral-600">
        <p>
          Ob für den Vereinssport, das Training mit der Jugendmannschaft oder den Spaß im eigenen Garten –
          das richtige Fußballtor zu finden, ist nicht immer einfach. Unterschiedliche Größen, Materialien
          und Preisklassen machen die Auswahl komplex. Genau hier hilft fussballtore.de.
        </p>
        <p>
          Als professioneller Ratgeber vergleichen wir Fußballtore aller Kategorien: Von professionellen
          Großfeldtoren (7,32 x 2,44 m) über robuste Bolzplatztore bis hin zu praktischen Pop-up-Toren
          für den Garten. Wir erklären, welche Größe für welchen Zweck passt, vergleichen Aluminium mit Kunststoff
          und geben konkrete Kaufempfehlungen.
        </p>
        <p>
          Unsere Produktempfehlungen stammen von Fachhändlern für Vereinsbedarf – TÜV-geprüfte Tore,
          die in Deutschland hergestellt werden.
          So bekommst du Qualität, auf die du dich verlassen kannst.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <div class="bg-neutral-50">
    <div class="container mx-auto">
      <FAQSection faqs={faqs} />
    </div>
  </div>
</BaseLayout>
