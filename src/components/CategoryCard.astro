---
import { foto, type FotoKey } from '../utils/shop-image';

interface Props {
  name: string;
  subtitle: string;
  href: string;
  /** Foto aus src/data/fotos.json */
  image?: FotoKey;
}

const { name, subtitle, href, image } = Astro.props;
const bild = image ? foto(image) : null;
---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-xl bg-neutral-50 no-underline ring-1 ring-neutral-200 transition-[box-shadow,transform] duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_12px_24px_-12px_rgba(15,23,42,0.25)] hover:ring-accent/40"
>
  {bild && (
    <span class="block aspect-[3/2] overflow-hidden bg-neutral-100">
      <img
        src={bild.src}
        srcset={bild.srcset}
        sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 100vw"
        alt={bild.alt}
        width="640"
        height="427"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
      />
    </span>
  )}
  <span class="flex flex-1 items-start justify-between gap-3 p-4 md:p-5">
    <span>
      <span class="block font-heading text-lg font-bold text-primary group-hover:text-accent-dark transition-colors">{name}</span>
      <span class="mt-0.5 block text-sm leading-snug text-neutral-500">{subtitle}</span>
    </span>
    <svg class="mt-1 h-5 w-5 flex-none text-neutral-400 transition-[transform,color] duration-200 ease-out group-hover:translate-x-1 group-hover:text-accent-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
    </svg>
  </span>
</a>
