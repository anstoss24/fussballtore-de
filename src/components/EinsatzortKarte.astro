---
/**
 * Startseite „Fußballtore nach Einsatzort“: Ortsillustration, Name, Kurzbeschreibung und „Geeignet: …“.
 * Gleicher Kartenaufbau wie TorartKarte, Bildfläche 3:2.
 *
 * Bilder: KI-generierte Stimmungsbilder (Gemini), Entscheidung Matze 04.11.2026 – zeigen den Ort,
 * kein bestimmtes Produkt. Dateien: public/images/orte/{ort}-400|800.webp.
 * Rückweg: Eintrag in ORT_FOTOS löschen, dann zeigt die Karte wieder die gezeichnete OrtIllustration.
 */
import OrtIllustration from './OrtIllustration.astro';
import { foto as shopFoto, type FotoKey } from '../utils/shop-image';

/** Bildausschnitt je Ort (object-position), damit das Tor in jedem Kartenformat sichtbar bleibt */
// shop: echtes Foto aus dem anstoss24-Shop (src/data/fotos.json, kein „Symbolbild“-Hinweis), sonst KI-Bild aus public/images/orte/
const ORT_FOTOS: Record<string, { position: string; shop?: FotoKey }> = {
  verein: { position: '30% 70%' },
  schule: { position: '85% 70%' },
  kommune: { position: '50% 60%', shop: 'ort-kommune' },
  spielplatz: { position: '50% 65%', shop: 'ort-spielplatz' },
  garten: { position: '25% 70%' },
};

interface Props {
  ort: string;
  name: string;
  href: string;
  subtitle: string;
  geeignet: string[];
  /** Letzte Karte einer ungeraden Reihe: füllt im 2er-Raster die ganze Zeile */
  wide?: boolean;
}

const { ort, name, href, subtitle, geeignet, wide = false } = Astro.props;
const foto = ORT_FOTOS[ort];
const shop = foto?.shop ? shopFoto(foto.shop) : undefined;
const bild = foto && {
  src: shop?.src ?? `/images/orte/${ort}-800.webp`,
  srcset: shop ? shop.srcset : `/images/orte/${ort}-400.webp 400w, /images/orte/${ort}-800.webp 800w`,
  symbolbild: !shop,
};
---

<a
  href={href}
  class:list={[
    wide && 'col-span-2 lg:col-span-1',
    'group flex h-full flex-col overflow-hidden rounded-xl bg-white no-underline ring-1 ring-neutral-200 transition-[box-shadow,transform] duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_12px_24px_-12px_rgba(15,23,42,0.25)] hover:ring-accent/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
  ]}
>
  <span class:list={['relative block overflow-hidden bg-neutral-100', wide ? 'aspect-[2/1] sm:aspect-[3/1] lg:aspect-[3/2]' : 'aspect-[3/2]']}>
    {foto && bild ? (
      <img
        src={bild.src}
        srcset={bild.srcset}
        sizes={wide ? '(min-width: 1024px) 20vw, 100vw' : '(min-width: 1024px) 20vw, 50vw'}
        alt=""
        loading="lazy"
        decoding="async"
        width="800"
        height="533"
        style={`object-position: ${foto.position}`}
        class="block h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
      />
    ) : (
      <OrtIllustration ort={ort} dekorativ class="block h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.04]" />
    )}
    {bild?.symbolbild && (
      <span class="pointer-events-none absolute bottom-1.5 right-1.5 rounded bg-black/45 px-1.5 py-px text-[0.625rem] font-medium leading-4 tracking-wide text-white/90 backdrop-blur-sm">
        Symbolbild
      </span>
    )}
  </span>
  <span class="flex flex-1 items-start justify-between gap-2 p-3 sm:p-4 md:p-5">
    <span class="flex h-full min-w-0 flex-col">
      <span class="block font-heading text-lg font-bold leading-snug text-primary group-hover:text-accent-dark transition-colors">{name}</span>
      <span class="mt-0.5 block text-sm leading-snug text-neutral-500">{subtitle}</span>
      <span class="mt-2 block text-sm leading-snug text-neutral-600">
        <span class="font-semibold text-primary">Geeignet:</span>{' '}
        {geeignet.map((g, i) => (
          <>
            <span class="sm:whitespace-nowrap">{g.replaceAll('-', '‑')}{i < geeignet.length - 1 && ' ·'}</span>{' '}
          </>
        ))}
      </span>
    </span>
    <svg class="mt-1 h-5 w-5 flex-none text-neutral-400 transition-[transform,color] duration-200 ease-out group-hover:translate-x-1 group-hover:text-accent-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
    </svg>
  </span>
</a>
