---
/**
 * Consent-Banner + Consent-gesteuerter Loader für Marketing-Pixel.
 *
 * Verhalten:
 * - Keine gespeicherte Entscheidung → Banner sichtbar, kein Pixel geladen.
 * - "Akzeptieren" → Entscheidung speichern, Pixel-SDKs laden, Consent = true.
 * - "Ablehnen" → Entscheidung speichern, nichts laden. Bei vorheriger
 *   Zustimmung: Consent widerrufen und gesetzte Cookies löschen.
 * - Footer-Link [data-consent-open] öffnet den Banner erneut (Widerruf).
 * - Klicks auf Links zu anstoss24.de werden als Conversion gemeldet,
 *   aber nur bei erteilter Zustimmung.
 *
 * Rendert nichts, wenn kein Dienst in src/data/consent.ts aktiv ist.
 */
import { consentConfig, activeServices, consentEnabled } from '../data/consent';

const services = activeServices.map(({ id, pixelId, cookies }) => ({ id, pixelId, cookies }));
const serviceNames = activeServices.map((s) => s.name);
const { storageKey, version, maxAgeDays } = consentConfig;
---

{consentEnabled && (
  <>
    <div
      id="consent-banner"
      role="dialog"
      aria-modal="false"
      aria-labelledby="consent-title"
      aria-describedby="consent-text"
      hidden
      class="fixed inset-x-0 bottom-0 z-50 p-3 sm:p-5"
    >
      <div class="mx-auto max-w-3xl rounded-2xl border border-neutral-200 bg-white p-5 sm:p-6 shadow-[0_-4px_32px_rgba(15,23,42,0.18)]">
        <p id="consent-title" class="font-heading text-lg font-bold text-primary mb-2">
          Erfolgsmessung unserer Werbeanzeigen
        </p>
        <p id="consent-text" class="text-[0.95rem] leading-relaxed text-neutral-500 mb-4">
          Wir schalten Werbeanzeigen, unter anderem in ChatGPT. Um zu messen, ob diese Anzeigen
          Besucher auf fussballtore.de bringen, möchten wir mit deiner Zustimmung
          {serviceNames.length === 1 ? 'folgenden Dienst' : 'folgende Dienste'} einsetzen:
          <strong class="text-primary">{serviceNames.join(', ')}</strong>.
          Dabei werden Cookies gesetzt und Daten in die USA übertragen. Ohne Zustimmung
          funktioniert die Website genauso, nur die Messung entfällt. Details in der
          <a href="/datenschutz/" class="underline text-primary hover:text-accent">Datenschutzerklärung</a>.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <button
            type="button"
            data-consent-reject
            class="w-full rounded-xl border-2 border-primary px-5 py-3 text-base font-semibold text-primary hover:bg-neutral-50 transition-colors"
          >
            Ablehnen
          </button>
          <button
            type="button"
            data-consent-accept
            class="w-full rounded-xl border-2 border-accent bg-accent px-5 py-3 text-base font-semibold text-white hover:bg-accent-dark hover:border-accent-dark transition-colors"
          >
            Akzeptieren
          </button>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ services, storageKey, version, maxAgeDays }}>
      (function () {
        var banner = document.getElementById('consent-banner');
        if (!banner) return;

        var loaded = {};
        var granted = false;

        /* ---------- Speicherung ---------- */
        function readDecision() {
          try {
            var raw = localStorage.getItem(storageKey);
            if (!raw) return null;
            var v = JSON.parse(raw);
            if (!v || v.v !== version) return null;
            if (Date.now() - v.ts > maxAgeDays * 86400000) return null;
            return v;
          } catch (e) {
            return null;
          }
        }
        function writeDecision(marketing) {
          try {
            localStorage.setItem(storageKey, JSON.stringify({ v: version, ts: Date.now(), marketing: marketing }));
          } catch (e) {}
        }

        /* ---------- Cookies löschen ---------- */
        function deleteCookie(name) {
          var host = location.hostname;
          var parts = host.split('.');
          var domains = ['', host];
          if (parts.length > 2) domains.push(parts.slice(-2).join('.'));
          domains.forEach(function (d) {
            document.cookie = name + '=; Max-Age=0; path=/' + (d ? '; domain=' + d : '');
          });
        }

        /* ---------- Loader je Dienst ---------- */
        var loaders = {
          openai: function (pixelId) {
            (function (w, d, s, u) {
              if (w.oaiq) return;
              var q = function () { q.q.push(arguments); };
              q.q = [];
              w.oaiq = q;
              var js = d.createElement(s);
              js.async = true;
              js.src = u;
              var f = d.getElementsByTagName(s)[0];
              f.parentNode.insertBefore(js, f);
            })(window, document, 'script', 'https://bzrcdn.openai.com/sdk/oaiq.min.js');
            window.oaiq('consent', true);
            window.oaiq('init', { pixelId: pixelId });
          },
          meta: function (pixelId) {
            /* Standard-Snippet von Meta */
            (function (f, b, e, v, n, t, s) {
              if (f.fbq) return;
              n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
              if (!f._fbq) f._fbq = n;
              n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
              t = b.createElement(e); t.async = true; t.src = v;
              s = b.getElementsByTagName(e)[0];
              s.parentNode.insertBefore(t, s);
            })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
            window.fbq('consent', 'grant');
            window.fbq('init', pixelId);
            window.fbq('track', 'PageView');
          },
        };

        function grant() {
          granted = true;
          services.forEach(function (s) {
            if (loaded[s.id] || !s.pixelId || !loaders[s.id]) return;
            try {
              loaders[s.id](s.pixelId);
              loaded[s.id] = true;
            } catch (e) {}
          });
        }

        function revoke() {
          granted = false;
          try { if (window.oaiq) window.oaiq('consent', false); } catch (e) {}
          try { if (window.fbq) window.fbq('consent', 'revoke'); } catch (e) {}
          services.forEach(function (s) {
            (s.cookies || []).forEach(deleteCookie);
          });
        }

        /* ---------- Conversion: Klick zu anstoss24.de ---------- */
        document.addEventListener('click', function (e) {
          if (!granted) return;
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          try {
            var host = new URL(a.href, location.href).hostname;
            if (!/(^|\.)anstoss24\.de$/.test(host)) return;
            if (loaded.openai && window.oaiq) {
              window.oaiq('measure', 'custom', { type: 'custom' }, { custom_event_name: 'anstoss24_click' });
            }
            if (loaded.meta && window.fbq) {
              window.fbq('trackCustom', 'Anstoss24Click');
            }
          } catch (err) {}
        }, true);

        /* ---------- Banner ---------- */
        function show() {
          banner.hidden = false;
          var btn = banner.querySelector('[data-consent-reject]');
          if (btn) btn.focus({ preventScroll: true });
        }
        function hide() {
          banner.hidden = true;
        }

        banner.querySelector('[data-consent-accept]').addEventListener('click', function () {
          writeDecision(true);
          grant();
          hide();
        });
        banner.querySelector('[data-consent-reject]').addEventListener('click', function () {
          var wasGranted = granted;
          writeDecision(false);
          if (wasGranted) revoke();
          hide();
        });

        document.querySelectorAll('[data-consent-open]').forEach(function (el) {
          el.addEventListener('click', function (ev) {
            ev.preventDefault();
            show();
          });
        });

        /* ---------- Start ---------- */
        var decision = readDecision();
        if (!decision) {
          show();
        } else if (decision.marketing) {
          grant();
        }
      })();
    </script>
  </>
)}
