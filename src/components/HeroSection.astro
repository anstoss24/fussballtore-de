---
import { foto, type FotoKey } from '../utils/shop-image';

interface Props {
  title: string;
  subtitle?: string;
  compact?: boolean;
  ctaText?: string;
  ctaHref?: string;
  /** Optionales Foto aus src/data/fotos.json als Hintergrund (abgedunkelt in Navy) */
  image?: FotoKey;
}

const { title, subtitle, compact = false, ctaText, ctaHref, image } = Astro.props;
const bild = image ? foto(image) : null;
---

<section
  class:list={[
    'relative isolate overflow-hidden bg-primary text-white',
    compact ? 'py-12 md:py-16' : 'py-16 md:py-24',
  ]}
>
  {bild && (
    <>
      <img
        src={bild.src}
        srcset={bild.srcset}
        sizes="100vw"
        alt=""
        width="1280"
        height="859"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
      />
      <!-- Flache Navy-Abdunklung, damit die Schrift auf dem Foto lesbar bleibt -->
      <div class="absolute inset-0 -z-10 bg-primary/80" aria-hidden="true"></div>
    </>
  )}

  <div class:list={['relative container mx-auto', bild ? 'max-w-5xl text-center' : 'max-w-4xl']}>
    <h1 class:list={['font-heading font-extrabold text-white', compact ? 'mb-3' : 'mb-4 md:mb-5']}>
      {title}
    </h1>
    {subtitle && (
      <p
        class:list={[
          'text-lg md:text-xl text-white/85 leading-relaxed max-w-2xl',
          bild ? 'mx-auto mb-8' : 'mb-0',
          ctaText && !bild ? 'mb-8' : '',
        ]}
      >
        {subtitle}
      </p>
    )}
    {ctaText && ctaHref && (
      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white font-heading font-bold text-base px-7 py-3.5 rounded-lg transition-[background-color,transform] duration-150 active:scale-[0.97] no-underline mt-8"
      >
        {ctaText}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    )}
    <slot />
  </div>
</section>
