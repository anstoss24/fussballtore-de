---
import TorLinien from './TorLinien.astro';
import { BANNER_TORE } from '../data/einsatzorte';

interface Props {
  title: string;
  subtitle?: string;
  compact?: boolean;
  /** Startseite: niedriger als der volle Hero, damit die Torart-Karten früher sichtbar sind */
  mittel?: boolean;
  ctaText?: string;
  ctaHref?: string;
}

const { title, subtitle, compact = false, mittel = false, ctaText, ctaHref } = Astro.props;
// Unterseiten-Banner: maßstabsgetreue Tor-Linien passend zum Seitenthema (src/data/einsatzorte.ts)
const tore = compact ? BANNER_TORE[Astro.url.pathname] : undefined;
---

<section
  class:list={[
    'relative isolate overflow-hidden text-white',
    compact ? 'py-12 md:py-16' : mittel ? 'py-16 md:py-20' : 'py-20 md:py-28',
  ]}
>
  <!-- Navy-Verlauf mit dezenten Spielfeldlinien -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-primary via-primary-light to-primary" aria-hidden="true">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 25% 50%, rgba(22, 163, 74, 0.3) 0%, transparent 50%), radial-gradient(circle at 75% 50%, rgba(245, 158, 11, 0.2) 0%, transparent 50%);"></div>

    <svg
      class="absolute inset-0 w-full h-full opacity-[0.07]"
      viewBox="0 0 1200 600"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      <g fill="none" stroke="white" stroke-width="2">
        <circle cx="600" cy="300" r="90" />
        <line x1="600" y1="0" x2="600" y2="600" />
        <rect x="0" y="180" width="160" height="240" />
        <rect x="0" y="240" width="60" height="120" />
        <rect x="1040" y="180" width="160" height="240" />
        <rect x="1140" y="240" width="60" height="120" />
      </g>
    </svg>

    {!compact && (
      <svg
        class="absolute right-0 top-1/2 -translate-y-1/2 h-3/4 w-auto opacity-[0.09] hidden md:block"
        viewBox="0 0 240 180"
        aria-hidden="true"
      >
        <g fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="square">
          <path d="M 30 160 L 30 30 L 210 30 L 210 160" />
          <g stroke-width="1" opacity="0.5">
            <line x1="48" y1="38" x2="48" y2="160" />
            <line x1="72" y1="38" x2="72" y2="160" />
            <line x1="96" y1="38" x2="96" y2="160" />
            <line x1="120" y1="38" x2="120" y2="160" />
            <line x1="144" y1="38" x2="144" y2="160" />
            <line x1="168" y1="38" x2="168" y2="160" />
            <line x1="192" y1="38" x2="192" y2="160" />
            <line x1="30" y1="55" x2="210" y2="55" />
            <line x1="30" y1="80" x2="210" y2="80" />
            <line x1="30" y1="110" x2="210" y2="110" />
            <line x1="30" y1="140" x2="210" y2="140" />
          </g>
        </g>
      </svg>
    )}
  </div>

  <div
    class:list={[
      'relative container mx-auto',
      compact ? 'md:grid md:grid-cols-[minmax(0,1fr)_13rem] lg:grid-cols-[minmax(0,1fr)_24rem] md:items-end md:gap-10' : 'max-w-5xl text-center',
    ]}
  >
    <div class:list={[compact ? 'max-w-3xl' : '']}>
      <h1 class:list={['font-heading font-extrabold text-white', compact ? 'mb-3' : 'mb-4 md:mb-5']}>
        {title}
      </h1>
      {subtitle && (
        <p
          class:list={[
            'text-lg md:text-xl text-white/85 leading-relaxed max-w-2xl',
            compact ? 'mb-0' : 'mx-auto mb-8',
          ]}
        >
          {subtitle}
        </p>
      )}
      {ctaText && ctaHref && (
        <a
          href={ctaHref}
          class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white font-heading font-bold text-base px-7 py-3.5 rounded-lg transition-[background-color,transform] duration-150 active:scale-[0.97] no-underline"
        >
          {ctaText}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      )}
      <slot />
    </div>

    {tore && (
      <div class="hidden md:block text-accent-light/70">
        <TorLinien tore={tore} masse breiteM={tore.length === 1 ? 4.5 : undefined} pxBreite={384} class="ml-auto block h-auto w-full max-h-32" />
      </div>
    )}
  </div>
</section>
