---
import Karte from './Karte.astro';
import { massstabM, type Karte as KarteDaten } from './daten';

interface Props {
  karten: KarteDaten[];
  stil: 'foto' | 'linie';
  /** Erstes Bild nicht lazy laden (liegt im ersten Bildschirm) */
  eager?: boolean;
}

const { karten, stil, eager = false } = Astro.props;
const massstab = massstabM(karten);
---

<div class="grid grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-4 md:gap-5">
  {karten.map((k, i) => (
    <Karte karte={k} stil={stil} wide={karten.length % 2 === 1 && i === karten.length - 1} eager={eager && i === 0} massstabM={massstab} />
  ))}
</div>
