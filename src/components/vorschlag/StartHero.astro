---
/** Startseiten-Hero für die Vorschläge: wie HeroSection, aber mit wählbarer Höhe */
interface Props {
  title: string;
  subtitle: string;
  hoehe?: 'normal' | 'mittel' | 'niedrig';
}

const { title, subtitle, hoehe = 'normal' } = Astro.props;
const hatSlot = Astro.slots.has('default');
---

<section
  class:list={[
    'relative isolate overflow-hidden text-white',
    { normal: 'py-20 md:py-28', mittel: 'py-16 md:py-20', niedrig: 'py-12 md:py-14' }[hoehe],
  ]}
>
  <!-- Navy-Verlauf mit dezenten Spielfeldlinien -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-primary via-primary-light to-primary" aria-hidden="true">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 25% 50%, rgba(22, 163, 74, 0.3) 0%, transparent 50%), radial-gradient(circle at 75% 50%, rgba(245, 158, 11, 0.2) 0%, transparent 50%);"></div>
    <svg class="absolute inset-0 w-full h-full opacity-[0.07]" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g fill="none" stroke="white" stroke-width="2">
        <circle cx="600" cy="300" r="90" />
        <line x1="600" y1="0" x2="600" y2="600" />
        <rect x="0" y="180" width="160" height="240" />
        <rect x="0" y="240" width="60" height="120" />
        <rect x="1040" y="180" width="160" height="240" />
        <rect x="1140" y="240" width="60" height="120" />
      </g>
    </svg>
  </div>

  <div class="relative container mx-auto max-w-5xl text-center">
    <h1 class:list={['font-heading font-extrabold text-white', hoehe === 'niedrig' ? 'mb-3' : 'mb-4 md:mb-5']}>{title}</h1>
    <p class:list={['text-lg md:text-xl text-white/85 leading-relaxed max-w-2xl mx-auto', hatSlot ? (hoehe === 'niedrig' ? 'mb-5' : 'mb-8') : 'mb-0']}>
      {subtitle}
    </p>
    <slot />
  </div>
</section>
