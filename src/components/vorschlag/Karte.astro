---
/**
 * Karte für Torart oder Einsatzort – einheitlich in Größe und Aufbau.
 * stil „foto“: ein Foto bzw. Collage aus 2–4 Fotos der passenden Torarten.
 * stil „linie“: maßstabsgetreue Linienzeichnung (TorLinien) auf heller Fläche.
 * stil „ort“: Illustration des Einsatzorts (OrtIllustration), gleiche Bildfläche wie „foto“.
 * stil „ortfoto“: Stockfoto des Einsatzorts (OrtFoto), gleiche Bildfläche wie „foto“.
 */
import TorLinien from '../TorLinien.astro';
import OrtIllustration from './OrtIllustration.astro';
import OrtFoto from './OrtFoto.astro';
import { foto } from '../../utils/shop-image';
import { torReihen, reiheBreiteM, type Karte } from './daten';

interface Props {
  karte: Karte;
  stil: 'foto' | 'linie' | 'ort' | 'ortfoto';
  /** Letzte Karte einer ungeraden Reihe: füllt im 2er-Raster die ganze Zeile */
  wide?: boolean;
  /** Erstes Bild im sichtbaren Bereich: nicht lazy laden */
  eager?: boolean;
  /** Linienzeichnung: Meter, die der vollen Kartenbreite entsprechen (gleich für alle Karten eines Rasters) */
  massstabM?: number;
}

const { karte, stil, wide = false, eager = false, massstabM = 1 } = Astro.props;
const bilder = karte.fotos.map(foto);
const einzeln = bilder.length === 1;

// Linienzeichnung: alle Karten eines Rasters im selben Maßstab
const reihen = torReihen(karte.tore).map((tore) => ({ tore, breite: `${((reiheBreiteM(tore) / massstabM) * 100).toFixed(1)}%` }));

const bildFlaeche = wide ? 'aspect-[2/1] sm:aspect-[3/1] lg:aspect-[3/2]' : 'aspect-[3/2]';
const sizesEinzeln = wide ? '(min-width: 1024px) 240px, 100vw' : '(min-width: 1024px) 240px, 50vw';
const sizesKachel = wide ? '(min-width: 1024px) 120px, 50vw' : '(min-width: 1024px) 120px, 25vw';
---

<a
  href={karte.href}
  class:list={[
    wide && 'col-span-2 lg:col-span-1',
    'group flex h-full flex-col overflow-hidden rounded-xl bg-white no-underline ring-1 ring-neutral-200 transition-[box-shadow,transform] duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_12px_24px_-12px_rgba(15,23,42,0.25)] hover:ring-accent/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
  ]}
>
  {stil === 'ortfoto' && karte.ort ? (
    <span class:list={['block overflow-hidden bg-neutral-100', bildFlaeche]}>
      <OrtFoto ort={karte.ort} sizes={sizesEinzeln} eager={eager} class="block h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.04]" />
    </span>
  ) : stil === 'ort' && karte.ort ? (
    <span class:list={['block overflow-hidden bg-neutral-100', bildFlaeche]}>
      <OrtIllustration ort={karte.ort} dekorativ class="block h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.04]" />
    </span>
  ) : stil !== 'linie' ? (
    <span
      class:list={[
        'block overflow-hidden bg-neutral-100',
        bildFlaeche,
        !einzeln && 'grid grid-cols-2 gap-0.5',
        bilder.length >= 3 && 'grid-rows-2',
      ]}
    >
      {bilder.map((b, i) => (
        <span class:list={['block overflow-hidden', bilder.length === 3 && i === 0 && 'row-span-2']}>
          <img
            src={b.src}
            srcset={b.srcset}
            sizes={einzeln ? sizesEinzeln : sizesKachel}
            alt={einzeln ? b.alt : ''}
            width="640"
            height="427"
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          />
        </span>
      ))}
    </span>
  ) : (
    <span class:list={['flex justify-center border-b border-neutral-200 bg-neutral-50 px-3 pb-3 pt-4 sm:px-4 text-accent-dark', wide ? 'aspect-[3/1] lg:aspect-[3/2]' : 'aspect-[3/2]']}>
      <span class:list={['flex flex-col items-center justify-end gap-2', wide ? 'w-1/2 lg:w-full' : 'w-full']}>
        {reihen.map((r) => (
          <span class="block" style={`width: ${r.breite}`}>
            <TorLinien tore={r.tore} class="block h-auto w-full" />
          </span>
        ))}
      </span>
    </span>
  )}
  <span class="flex flex-1 items-start justify-between gap-2 p-3 sm:p-4 md:p-5">
    <span class="flex h-full min-w-0 flex-col">
      <span class="block font-heading text-lg font-bold leading-snug text-primary group-hover:text-accent-dark transition-colors">{karte.name}</span>
      {karte.meta && <span class="mt-0.5 block text-sm font-semibold text-accent-dark" style="font-variant-numeric: tabular-nums">{karte.meta}</span>}
      <span class="mt-0.5 block text-sm leading-snug text-neutral-500">{karte.subtitle}</span>
      {karte.geeignet && (
        <span class="mt-2 block text-sm leading-snug text-neutral-600">
          <span class="font-semibold text-primary">Geeignet:</span>{' '}
          {karte.geeignet.map((g, i) => (
            <>
              <span class="sm:whitespace-nowrap">{g.replaceAll('-', '\u2011')}{i < karte.geeignet!.length - 1 && ' ·'}</span>{' '}
            </>
          ))}
        </span>
      )}
      {karte.info && (
        <span class="mt-auto block pt-2 text-sm font-medium text-neutral-600" style="font-variant-numeric: tabular-nums">{karte.info}</span>
      )}
    </span>
    <svg class="mt-1 h-5 w-5 flex-none text-neutral-400 transition-[transform,color] duration-200 ease-out group-hover:translate-x-1 group-hover:text-accent-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
    </svg>
  </span>
</a>
