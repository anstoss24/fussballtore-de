---
/**
 * Flache Illustration eines Einsatzorts (Sportplatz, Bolzplatz, Schulhof, Spielplatz, Garten) für die Einsatzort-Karten.
 * Bewusst gezeichnet statt Foto: Wir haben keine eigenen Ortsfotos, KI-Fotos kommen nicht infrage.
 * Eine Bühne 240 × 160 (3:2), Horizont bei y = 96; Himmel, Boden und Zäune laufen seitlich über die Bühne hinaus,
 * damit die breite Karte (2:1, 3:1) ohne Beschnitt gefüllt wird. Tore generisch, kein bestimmtes Produkt.
 */
interface Props {
  ort: string;
  /** Kartentitel nennt den Ort schon: Illustration vor Screenreadern verbergen */
  dekorativ?: boolean;
  class?: string;
}

const { ort, dekorativ = false, class: className } = Astro.props;

const NAME: Record<string, string> = {
  verein: 'Sportplatz',
  kommune: 'Bolzplatz',
  schule: 'Schulhof',
  spielplatz: 'Spielplatz',
  garten: 'Garten',
};

// Farben: Navy, Slate-Töne, drei Grüntöne (hell, mittel, Akzent)
const NAVY = '#0f172a';
const HELL = '#dcfce7';
const MITTEL = '#bbf7d0';
const LAUB = '#86efac';
const AKZENT = '#15803d';

const r = (n: number) => Math.round(n * 10) / 10;
const schritte = (von: number, bis: number, s: number) => Array.from({ length: Math.floor((bis - von) / s) + 1 }, (_, i) => von + i * s);

/** Mähstreifen in Zentralperspektive zwischen y0 und dem unteren Rand */
const streifen = (y0: number) =>
  schritte(-260, 480, 40)
    .filter((_, i) => i % 2 === 0)
    .map((x) => {
      const k = (y0 - 40) / 120;
      const a = 120 + (x - 120) * k;
      const b = 120 + (x + 20 - 120) * k;
      return `M${r(a)} ${y0}L${r(b)} ${y0}L${x + 20} 160L${x} 160Z`;
    })
    .join('');

/** Hecke bzw. Baumreihe am Horizont */
const hecke = schritte(-120, 360, 13).map((x, i) => ({ x, r: i % 3 === 0 ? 9 : 7 }));

/** Tor in Frontansicht: Rahmen 2er-Strich, Netz (Raster) oder Hinterbau (Streben) */
const tor = (x: number, y: number, b: number, h: number, hinterbau = false) => {
  const s = hinterbau ? 3.5 : 5;
  const senk = schritte(x + s, x + b - 1, s).map((d) => `M${r(d)} ${y - h}V${y}`).join('');
  const waag = hinterbau ? '' : schritte(y - h + s, y - 1, s).map((d) => `M${x} ${r(d)}H${x + b}`).join('');
  return { rahmen: `M${x} ${y}V${y - h}H${x + b}V${y}`, netz: senk + waag, x, y: y - h, b, h };
};

const torVerein = tor(84, 108, 72, 24);
const torBolz = tor(93, 112, 54, 36, true);
const torSchule = tor(162, 126, 39, 26, true);
const torSpiel = tor(186, 116, 33, 22, true);
const torGarten = tor(132, 130, 42, 28);
const tore = { verein: torVerein, kommune: torBolz, schule: torSchule, spielplatz: torSpiel, garten: torGarten } as Record<string, ReturnType<typeof tor>>;
const t = tore[ort];

// Fenster der Schule: zwei Reihen je Flügel
const fenster = [50, 70].flatMap((y) => [...schritte(28, 82, 18), ...schritte(150, 204, 18)].map((x) => ({ x, y })));
---

<svg
  viewBox="0 0 240 160"
  preserveAspectRatio="xMidYMax meet"
  class={className}
  style="overflow: visible"
  role={dekorativ ? undefined : 'img'}
  aria-label={dekorativ ? undefined : `Illustration ${NAME[ort]}`}
  aria-hidden={dekorativ ? 'true' : undefined}
  focusable="false"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect x="-400" y="-100" width="1040" height="196" fill="#f1f5f9" />
  <rect x="-400" y="96" width="1040" height="64" fill={ort === 'schule' ? '#e2e8f0' : HELL} />

  {ort === 'verein' && (
    <>
      <g fill={LAUB}>{hecke.map((h) => <circle cx={h.x} cy={96 - h.r / 2} r={h.r} />)}</g>
      <path d={streifen(96)} fill={MITTEL} />
      {/* Flutlichtmast */}
      <path d="M30 96V26" stroke={NAVY} stroke-width="1.75" />
      <rect x="19" y="16" width="22" height="11" rx="1.5" fill={NAVY} />
      <g fill="#f8fafc">{[22, 27, 32, 37].map((x) => <rect x={x - 0.5} y="18.5" width="3" height="6" rx="0.5" />)}</g>
      {/* Tribüne */}
      <path d="M164 96V82H176V74H188V66H232V96Z" fill="#cbd5e1" />
      <path d="M164 82H232M176 74H232M188 66H232" stroke="#f8fafc" stroke-width="1.5" />
      <path d="M182 56H238M186 57V66M234 57V66" stroke={NAVY} stroke-width="1.75" />
      {/* Linien: Torlinie und Torraum */}
      <path d="M-400 108H640M60 108L38 128H202L180 108" fill="none" stroke="#fff" stroke-width="2.25" />
    </>
  )}

  {ort === 'kommune' && (
    <>
      {/* Häuser und Bäume im Hintergrund */}
      <g fill="#e2e8f0">
        <rect x="-12" y="70" width="46" height="26" />
        <rect x="198" y="66" width="52" height="30" />
      </g>
      <g fill="#94a3b8">
        <path d="M-16 70L11 54L38 70Z" />
        <path d="M194 66L224 48L254 66Z" />
      </g>
      <g fill="#f8fafc">
        <rect x="0" y="78" width="7" height="8" /><rect x="18" y="78" width="7" height="8" />
        <rect x="208" y="75" width="7" height="8" /><rect x="228" y="75" width="7" height="8" />
      </g>
      <path d="M46 96V82M182 96V80" stroke="#64748b" stroke-width="2" />
      <circle cx="46" cy="74" r="12" fill={AKZENT} />
      <circle cx="182" cy="70" r="14" fill={LAUB} />
      {/* Spielfläche und Ballfangzaun */}
      <path d="M40 112H200L224 160H16Z" fill={MITTEL} />
      <g stroke={NAVY} fill="none">
        <path d={schritte(44, 196, 5).map((x) => `M${x} 58V112`).join('') + schritte(63, 108, 5).map((y) => `M40 ${y}H200`).join('')} stroke-width="0.6" opacity="0.22" />
        <path d={schritte(40, 200, 32).map((x) => `M${x} 56V112`).join('') + 'M40 56H200'} stroke-width="1.5" />
      </g>
      {/* Bank */}
      <path d="M10 126H44M12 120H42M14 126V134M40 126V134M14 120V126M40 120V126" stroke={NAVY} stroke-width="1.75" fill="none" />
      {/* Laterne */}
      <path d="M220 138V70Q220 64 213 64" stroke={NAVY} stroke-width="1.5" fill="none" />
      <path d="M207 64H219L216 68H210Z" fill={NAVY} />
    </>
  )}

  {ort === 'schule' && (
    <>
      {/* Schulgebäude mit Uhr und Eingang */}
      <rect x="20" y="40" width="200" height="56" fill="#cbd5e1" />
      <rect x="100" y="26" width="40" height="70" fill="#cbd5e1" />
      <path d="M16 38H96M144 38H224M96 25H144" stroke="#64748b" stroke-width="4" />
      <g fill="#f8fafc">{fenster.map((f) => <rect x={f.x} y={f.y} width="11" height="12" />)}</g>
      <circle cx="120" cy="42" r="7" fill="#f8fafc" stroke={NAVY} stroke-width="1.25" />
      <path d="M120 42V37.5M120 42L123 44" stroke={NAVY} stroke-width="1.25" />
      <rect x="110" y="72" width="20" height="24" fill="#64748b" />
      <path d="M120 72V96" stroke="#cbd5e1" stroke-width="1" />
      <rect x="-400" y="96" width="1040" height="5" fill={MITTEL} />
      {/* Baum */}
      <path d="M36 112V84" stroke="#64748b" stroke-width="2.5" />
      <circle cx="36" cy="74" r="15" fill={LAUB} />
      <circle cx="44" cy="80" r="9" fill={AKZENT} />
      {/* Hofmarkierung */}
      <path d="M70 108H226L236 150H60ZM148 108V150" fill="none" stroke="#fff" stroke-width="1.75" />
      <ellipse cx="148" cy="129" rx="16" ry="5" fill="none" stroke="#fff" stroke-width="1.75" />
    </>
  )}

  {ort === 'spielplatz' && (
    <>
      <g fill={LAUB}>{hecke.map((h) => <circle cx={h.x} cy={96 - h.r / 2} r={h.r} />)}</g>
      {/* Schaukel */}
      <path d="M8 112L18 58L28 112M64 112L74 58L84 112M18 58H74M32 58V96M44 58V96M50 58V96M62 58V96" fill="none" stroke={NAVY} stroke-width="1.5" />
      <g fill={NAVY}><rect x="30" y="95" width="16" height="3.5" rx="1" /><rect x="48" y="95" width="16" height="3.5" rx="1" /></g>
      {/* Rutsche mit Turm */}
      <path d="M100 52L110 42L120 52Z" fill={AKZENT} />
      <path d="M102 52V112M118 52V112M94 112L102 76M96 100H101M98 90H102M100 80H102" fill="none" stroke={NAVY} stroke-width="1.5" />
      <rect x="99" y="74" width="22" height="3" fill={NAVY} />
      <path d="M120 77C134 80 136 108 158 110" fill="none" stroke={AKZENT} stroke-width="5" />
      {/* Sandkasten */}
      <path d="M22 126H82L88 146H16Z" fill="#fef3c7" stroke="#94a3b8" stroke-width="2.5" />
      {/* Ballspielfläche */}
      <path d="M176 116H232L240 150H168Z" fill={MITTEL} />
      <path d="M176 116H232L240 150H168Z" fill="none" stroke="#fff" stroke-width="1.75" />
    </>
  )}

  {ort === 'garten' && (
    <>
      {/* Gartenzaun */}
      <g fill="#f8fafc" stroke="#94a3b8" stroke-width="1">
        {schritte(84, 640, 8).map((x) => <path d={`M${x} 96V84L${x + 2.5} 81L${x + 5} 84V96Z`} />)}
      </g>
      <path d="M80 87H640M80 93H640" stroke="#94a3b8" stroke-width="1" />
      <path d={streifen(96)} fill={MITTEL} />
      {/* Haus mit Terrasse und Markise */}
      <rect x="-40" y="50" width="126" height="50" fill="#e2e8f0" />
      <path d="M-46 50L22 18L92 50Z" fill="#64748b" />
      <rect x="2" y="62" width="18" height="18" fill="#f8fafc" stroke="#94a3b8" stroke-width="1" />
      <rect x="40" y="66" width="26" height="34" fill="#f8fafc" stroke="#94a3b8" stroke-width="1" />
      <path d="M53 66V100" stroke="#94a3b8" stroke-width="1" />
      <path d="M36 58H70L74 64H32Z" fill={AKZENT} />
      <path d="M-40 100H92L98 112H-40Z" fill="#cbd5e1" />
      <path d="M-40 104H94M-40 108H96" stroke="#e2e8f0" stroke-width="1" />
      {/* Baum */}
      <path d="M212 104V58" stroke="#64748b" stroke-width="3" />
      <circle cx="212" cy="46" r="24" fill={LAUB} />
      <circle cx="224" cy="56" r="13" fill={AKZENT} />
    </>
  )}

  {t && (
    <g fill="none" stroke={NAVY}>
      <rect x={t.x} y={t.y} width={t.b} height={t.h} fill="#fff" stroke="none" opacity="0.55" />
      <path d={t.netz} stroke-width="0.75" opacity="0.4" />
      <path d={t.rahmen} stroke-width="2" stroke-linecap="square" />
    </g>
  )}
</svg>
