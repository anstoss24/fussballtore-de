---
import { features } from '../data/features';
import { TORARTEN, TORART_REIHENFOLGE, EINSATZORTE } from '../data/einsatzorte';

const navItems = [
  { label: 'Kaufberatung', href: '/kaufberatung/' },
  { label: 'Größen', href: '/groessen/' },
  { label: 'Material', href: '/material-vergleich/' },
];

// Zwei Menüs, gleiche Datenquelle wie Startseite und Footer (src/data/einsatzorte.ts)
const torLinks = TORART_REIHENFOLGE.map((id) => ({ label: TORARTEN[id].plural, meta: TORARTEN[id].mass, href: TORARTEN[id].href }));
const alterLinks = [
  { label: 'Kindertore nach Alter', href: '/kinder/' },
  { label: 'Funino-Tore', href: '/funino/' },
];
const ortLinks = EINSATZORTE.map((e) => ({ label: e.name, meta: e.subtitle, href: e.href }));

const currentPath = Astro.url.pathname;
// Sprungmarken (/verein/#jugendtore) zählen nicht als aktiv, sonst leuchtet „Tore“ auch auf /verein/
const istAktiv = (links: { href: string }[]) => links.some((l) => l.href === currentPath);

const menus = [
  { id: 'tore', label: 'Tore', gruppen: [{ titel: 'Torarten', links: torLinks }, { titel: 'Nach Alter', links: alterLinks }] },
  { id: 'orte', label: 'Einsatzorte', gruppen: [{ titel: 'Wo steht das Tor?', links: ortLinks }] },
];

const linkKlasse = (aktiv: boolean) =>
  aktiv ? 'text-accent-dark bg-accent/10' : 'text-neutral-600 hover:text-primary hover:bg-neutral-100';
---

<header class="sticky top-0 z-50 bg-white border-b border-neutral-200">
  <div class="container mx-auto flex items-center justify-between h-16 md:h-18">
    <!-- Logo -->
    <a href="/" class="font-heading font-extrabold text-xl md:text-2xl text-primary hover:text-primary no-underline">
      fussballtore.de
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1" aria-label="Hauptnavigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['px-3 py-2 text-[0.95rem] font-medium rounded-lg transition-colors no-underline', linkKlasse(currentPath === item.href)]}
        >
          {item.label}
        </a>
      ))}

      {menus.map((m, mi) => (
        <details class="nav-menu relative" data-nav-menu>
          <summary
            class:list={[
              'flex cursor-pointer list-none items-center gap-1 px-3 py-2 text-[0.95rem] font-medium rounded-lg transition-colors select-none',
              linkKlasse(m.gruppen.some((g) => istAktiv(g.links))),
            ]}
          >
            {m.label}
            <svg class="nav-chevron h-4 w-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <div
            class:list={[
              'absolute top-full mt-2 w-64 rounded-xl bg-white p-2 shadow-[0_16px_32px_-12px_rgba(15,23,42,0.25)] ring-1 ring-neutral-200',
              mi === menus.length - 1 ? 'right-0' : 'left-0',
            ]}
          >
            {m.gruppen.map((g, gi) => (
              <div class:list={[gi > 0 && 'mt-1 border-t border-neutral-200 pt-1']}>
                <p class="px-3 pt-2 pb-1 text-xs font-semibold uppercase tracking-wide text-neutral-400 m-0">{g.titel}</p>
                <ul class="list-none p-0 m-0">
                  {g.links.map((l) => (
                    <li class="m-0">
                      <a
                        href={l.href}
                        class:list={['block rounded-lg px-3 py-2 text-[0.95rem] font-medium leading-snug no-underline transition-colors', linkKlasse(l.href === currentPath)]}
                      >
                        <span class="block">{l.label}</span>
                        {'meta' in l && l.meta && <span class="block text-xs font-normal text-neutral-400">{l.meta}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </details>
      ))}

      {features.torberater && (
        <a
          href="/torberater/"
          class:list={[
            'ml-2 px-4 py-2 text-sm font-semibold rounded-lg transition-colors no-underline border',
            currentPath === '/torberater/'
              ? 'bg-accent text-white border-accent'
              : 'text-accent-dark border-accent/50 hover:bg-accent hover:text-white hover:border-accent',
          ]}
        >
          Torberater
        </a>
      )}
    </nav>

    <!-- Mobile Menu Toggle -->
    <label for="mobile-menu-toggle" class="lg:hidden cursor-pointer p-2 -mr-2" aria-label="Menü öffnen">
      <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
  </div>

  <!-- Mobile Menu (CSS-only with checkbox hack) -->
  <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" aria-hidden="true" />
  <nav
    class="lg:hidden peer-checked:block hidden border-t border-neutral-200 bg-white max-h-[calc(100dvh-4rem)] overflow-y-auto"
    aria-label="Mobile Navigation"
  >
    <div class="container mx-auto py-3 grid gap-x-6 gap-y-4 sm:grid-cols-3">
      {[
        { titel: 'Ratgeber', links: [{ label: 'Startseite', href: '/' }, ...navItems, ...alterLinks] },
        { titel: 'Torarten', links: torLinks },
        { titel: 'Einsatzorte', links: ortLinks },
      ].map((g) => (
        <div>
          <p class="px-4 pt-1 pb-1 text-xs font-semibold uppercase tracking-wide text-neutral-400 m-0">{g.titel}</p>
          <div class="flex flex-col">
            {g.links.map((item) => (
              <a
                href={item.href}
                class:list={['px-4 py-2 rounded-lg text-base font-medium transition-colors no-underline', linkKlasse(currentPath === item.href)]}
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      ))}
      {features.torberater && (
        <a
          href="/torberater/"
          class="sm:col-span-3 px-4 py-2.5 rounded-lg text-base font-semibold text-center no-underline bg-accent text-white hover:bg-accent-dark transition-colors"
        >
          Torberater – passendes Tor finden
        </a>
      )}
    </div>
  </nav>
</header>

<script is:inline>
  // Desktop-Menüs: nur eins offen, schließen bei Klick daneben und mit Escape
  (() => {
    const menus = document.querySelectorAll('[data-nav-menu]');
    menus.forEach((m) =>
      m.addEventListener('toggle', () => {
        if (m.open) menus.forEach((o) => o !== m && o.removeAttribute('open'));
      }),
    );
    document.addEventListener('click', (e) => {
      menus.forEach((m) => !m.contains(e.target) && m.removeAttribute('open'));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      menus.forEach((m) => {
        if (m.open) {
          m.removeAttribute('open');
          m.querySelector('summary')?.focus();
        }
      });
    });
  })();
</script>

<style>
  .nav-menu > summary::-webkit-details-marker {
    display: none;
  }
  .nav-menu[open] .nav-chevron {
    transform: rotate(180deg);
  }
</style>
