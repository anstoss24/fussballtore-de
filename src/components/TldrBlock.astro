---
interface TldrItem {
  label?: string;
  text: string;
}

interface Props {
  title?: string;
  items: TldrItem[];
  /** Falls true, wird Speakable-Schema für Voice/AI ausgegeben. */
  speakable?: boolean;
  speakableId?: string;
}

const {
  title = 'Auf einen Blick',
  items,
  speakable = true,
  speakableId = 'tldr',
} = Astro.props;

const speakableSchema = speakable
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': new URL(Astro.url.pathname, Astro.site).href,
      url: new URL(Astro.url.pathname, Astro.site).href,
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: [`#${speakableId}`],
      },
    }
  : null;
---

<aside
  id={speakableId}
  class="my-8 rounded-xl bg-accent/[0.07] ring-1 ring-accent/20 p-6 md:p-7"
  aria-label={title}
>
  <div class="mb-4">
    <h2 class="font-heading text-lg md:text-xl font-bold text-primary m-0">
      {title}
    </h2>
  </div>
  <ul class="space-y-2.5 m-0 list-none p-0">
    {items.map((item) => (
      <li class="flex items-start gap-3 text-neutral-700 leading-relaxed">
        <svg
          class="w-2 h-2 mt-[0.7rem] text-accent flex-shrink-0"
          fill="currentColor"
          viewBox="0 0 8 8"
          aria-hidden="true"
        >
          <circle cx="4" cy="4" r="3" />
        </svg>
        <span>
          {item.label && (
            <strong class="text-primary font-semibold">{item.label}:</strong>
          )}
          {item.label ? ' ' : ''}{item.text}
        </span>
      </li>
    ))}
  </ul>
</aside>

{speakableSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />
)}
