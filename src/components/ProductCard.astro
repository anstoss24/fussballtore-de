---
import { addUtm } from '../utils/utm';
import pricesData from '../data/prices.json';
import { shopImage, shopImageArt, type Bildart } from '../utils/shop-image';
import galerien from '../data/produkt-galerien.json';

interface Props {
  name: string;
  url: string;
  imageUrl: string;
  features: string[];
  category?: string;
  campaign: string;
  /** Freisteller: ganz sichtbar mit Innenabstand; Szene: füllt die Fläche. Standard: vom Fetch-Skript erkannt */
  bildart?: Bildart;
  /** Nur für Karten im ersten Bildschirm */
  eager?: boolean;
}

const { name, url, imageUrl, features, category, campaign, bildart, eager = false } = Astro.props;
// Bildergalerie aus src/data/produkt-galerien.json (erstes Bild = Frontansicht), sonst nur imageUrl
const galerie = ((galerien as Record<string, unknown>)[url] as string[] | undefined) ?? [imageUrl];
const slides = galerie.map((src, i) => {
  const small = shopImage(src, 'c480');
  const large = shopImage(src, 'c960');
  return {
    src: large ?? small ?? src,
    srcset: small && large ? `${small} 480w, ${large} 960w` : undefined,
    art: (i === 0 && bildart) || shopImageArt(src) || 'freisteller',
    alt: i === 0 ? name : `${name} – Bild ${i + 1} von ${galerie.length}`,
  };
});
const mehrereBilder = slides.length > 1;

const priceInfo = (pricesData as Record<string, any>)[url];
const price = priceInfo?.price;
const uvp = priceInfo?.uvp;
const currency = priceInfo?.currency || 'EUR';
const priceValidUntil = priceInfo?.priceValidUntil;
const discount = uvp && price ? Math.round((1 - price / uvp) * 100) : null;

const formatPrice = (p: number) =>
  new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(p);

const productSchema: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  image: galerie.length > 1 ? galerie : galerie[0],
  url,
};

if (price) {
  productSchema.offers = {
    '@type': 'Offer',
    url,
    price,
    priceCurrency: currency,
    priceValidUntil,
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: {
      '@type': 'Organization',
      name: 'anstoss24.de',
    },
    ...(uvp && {
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        priceType: 'https://schema.org/StrikethroughPrice',
        price: uvp,
        priceCurrency: currency,
      },
    }),
  };
}
---

<article class="group flex h-full flex-col md:[:not(.max-w-md)>&:only-child]:col-span-2 md:[:not(.max-w-md)>&:only-child]:flex-row overflow-hidden rounded-xl bg-white ring-1 ring-neutral-200 transition-[box-shadow,transform] duration-200 ease-out hover:-translate-y-1 hover:shadow-[0_16px_32px_-16px_rgba(15,23,42,0.3)]">
  <!-- Product Schema (only with offers to satisfy Google rich result requirements) -->
  {price && (
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  )}

  <!-- Bilder: feste 4:3-Fläche gegen Layout-Sprünge, bei mehreren Bildern wischen oder per Pfeil blättern -->
  <div
    class="relative aspect-[4/3] overflow-hidden bg-white md:[:not(.max-w-md)>.group:only-child_&]:w-1/2 md:[:not(.max-w-md)>.group:only-child_&]:flex-none"
    data-galerie={mehrereBilder ? '' : undefined}
  >
    <ul
      class="flex h-full snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      aria-label={mehrereBilder ? `Produktbilder: ${name}` : undefined}
      data-track
    >
      {slides.map((slide, i) => (
        <li class="h-full w-full flex-none snap-center overflow-hidden">
          <img
            src={slide.src}
            srcset={slide.srcset}
            sizes="(min-width: 1024px) 480px, (min-width: 768px) 50vw, 100vw"
            alt={slide.alt}
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            width="960"
            height="720"
            draggable="false"
            class:list={[
              'h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.04]',
              slide.art === 'szene' ? 'object-cover' : 'object-contain p-6 mix-blend-multiply sm:p-8',
            ]}
          />
        </li>
      ))}
    </ul>
    {mehrereBilder && (
      <>
        <button
          type="button"
          data-prev
          aria-label="Vorheriges Bild"
          class="absolute left-2 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-primary shadow-[0_2px_8px_rgba(15,23,42,0.18)] ring-1 ring-neutral-200 transition-[background-color,transform] duration-150 hover:bg-white active:scale-[0.92] focus-visible:outline-2 focus-visible:outline-accent"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <button
          type="button"
          data-next
          aria-label="Nächstes Bild"
          class="absolute right-2 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-primary shadow-[0_2px_8px_rgba(15,23,42,0.18)] ring-1 ring-neutral-200 transition-[background-color,transform] duration-150 hover:bg-white active:scale-[0.92] focus-visible:outline-2 focus-visible:outline-accent"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
        <span
          class="pointer-events-none absolute bottom-2 right-2 rounded-full bg-primary/75 px-2 py-0.5 text-xs font-medium tabular-nums text-white"
          aria-live="polite"
          data-zaehler
        >
          1 / {slides.length}
        </span>
      </>
    )}
  </div>

  <!-- Content -->
  <div class="flex flex-1 flex-col p-5 md:[:not(.max-w-md)>.group:only-child_&]:p-7 md:[:not(.max-w-md)>.group:only-child_&]:justify-center">
    {category && (
      <span class="mb-1.5 text-sm font-semibold text-accent-dark">
        {category}
      </span>
    )}
    <h3 class="font-heading text-lg font-bold text-primary leading-snug mb-3 line-clamp-2">
      {name}
    </h3>

    <!-- Merkmale -->
    <ul class="flex flex-wrap gap-1.5 mb-4">
      {features.slice(0, 4).map((feature) => (
        <li class="text-[0.8125rem] leading-5 bg-neutral-100 text-neutral-600 px-2 py-0.5 rounded-md">
          {feature}
        </li>
      ))}
    </ul>

    <!-- Price -->
    {price && (
      <p class="mt-auto mb-4 flex flex-wrap items-baseline gap-x-2 gap-y-1 tabular-nums">
        <span class="font-heading text-xl font-bold text-primary">{formatPrice(price)} €</span>
        {uvp && (
          <span class="text-sm text-neutral-400 line-through">{formatPrice(uvp)} €</span>
        )}
        {discount && discount >= 5 && (
          <span class="text-[0.8125rem] font-semibold text-accent-dark bg-accent/10 px-1.5 py-0.5 rounded">
            -{discount}%
          </span>
        )}
      </p>
    )}

    <!-- CTA -->
    <a
      href={addUtm(url, campaign, 'product-card')}
      target="_blank"
      rel="noopener"
      class:list={[
        'block w-full text-center bg-accent hover:bg-accent-dark text-white font-semibold text-[0.95rem] py-3 px-4 rounded-lg transition-[background-color,transform] duration-150 active:scale-[0.97] no-underline',
        !price && 'mt-auto',
      ]}
    >
      Preis jetzt prüfen &rarr;
    </a>
  </div>
</article>

<script>
  // Bildergalerie der Produktkarten: Pfeile blättern (am Ende wieder von vorn), Wischen geht nativ per Scroll-Snap
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-galerie]').forEach((galerie) => {
    const track = galerie.querySelector<HTMLElement>('[data-track]')!;
    const zaehler = galerie.querySelector<HTMLElement>('[data-zaehler]');
    const anzahl = track.children.length;
    const aktuell = () => Math.round(track.scrollLeft / track.clientWidth);
    const gehe = (i: number) =>
      track.scrollTo({ left: ((i + anzahl) % anzahl) * track.clientWidth, behavior: reduce.matches ? 'auto' : 'smooth' });
    galerie.querySelector('[data-prev]')?.addEventListener('click', () => gehe(aktuell() - 1));
    galerie.querySelector('[data-next]')?.addEventListener('click', () => gehe(aktuell() + 1));
    track.addEventListener(
      'scroll',
      () => {
        if (zaehler) zaehler.textContent = `${aktuell() + 1} / ${anzahl}`;
      },
      { passive: true },
    );
  });
</script>
