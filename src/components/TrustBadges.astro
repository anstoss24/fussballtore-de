<section class="py-10 md:py-14 bg-primary text-white" aria-label="Qualitätsmerkmale">
  <div class="container mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-8 md:gap-8">
      <!-- Made in Germany -->
      <div class="border-t-2 border-accent-light pt-4">
        <div>
          <p class="font-heading text-lg md:text-xl font-bold text-white">Made in Germany</p>
          <p class="text-sm text-white/75 mt-1">Hergestellt in Deutschland</p>
        </div>
      </div>

      <!-- TÜV-geprüft -->
      <div class="border-t-2 border-accent-light pt-4">
        <div>
          <p class="font-heading text-lg md:text-xl font-bold text-white">TÜV-geprüft</p>
          <p class="text-sm text-white/75 mt-1">Sicherheit zertifiziert</p>
        </div>
      </div>

      <!-- Kostenloser Versand -->
      <div class="border-t-2 border-accent-light pt-4">
        <div>
          <p class="font-heading text-lg md:text-xl font-bold text-white">Kostenloser Versand</p>
          <p class="text-sm text-white/75 mt-1">Ab 75 &euro; Bestellwert</p>
        </div>
      </div>

      <!-- 30 Tage Rückgabe -->
      <div class="border-t-2 border-accent-light pt-4">
        <div>
          <p class="font-heading text-lg md:text-xl font-bold text-white">30 Tage Rückgabe</p>
          <p class="text-sm text-white/75 mt-1">Unkompliziert & kostenlos</p>
        </div>
      </div>
    </div>
  </div>
</section>
