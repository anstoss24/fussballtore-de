---
/** Hinweis am Ende von Ratgeber-Texten: vom Lesen zum Finden */
interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Genug gelesen?',
  text = 'Der Torberater fragt Größe, Einsatz und Ausstattung ab und zeigt dir alle passenden Tore mit aktuellem Preis.',
} = Astro.props;
---

<aside class="mt-12 rounded-2xl bg-primary text-white px-6 py-6 md:px-8 md:py-7 flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
  <div class="flex-1">
    <p class="text-sm font-semibold text-accent-light mb-1">Torberater</p>
    <p class="font-heading text-xl font-bold leading-snug">{title}</p>
    <p class="text-white/70 text-base mt-1">{text}</p>
  </div>
  <a
    href="/torberater/"
    class="inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-dark text-white font-heading font-bold text-base px-6 py-3 rounded-lg transition-colors no-underline whitespace-nowrap"
  >
    Passendes Tor finden
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
    </svg>
  </a>
</aside>
