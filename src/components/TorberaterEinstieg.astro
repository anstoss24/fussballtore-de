---
/**
 * Einstieg in den Torberater für dunkle Flächen (Startseiten-Hero):
 * Frage 1 „Torgröße“ als Kacheln, ein Klick öffnet /torberater/ mit Vorauswahl.
 */
import { tbTree, tbLabel, tbSlug, tbMeta } from '../utils/torberater';
import { shopImage } from '../utils/shop-image';
import { HINTS } from '../data/torberater-texte';

const tiles = tbTree.options.map((o) => ({
  label: tbLabel(o),
  hint: HINTS[`${tbTree.title}|${o.label}`],
  meta: tbMeta(o),
  image: shopImage(o.image, 480) ?? shopImage(o.image, 192),
  href: `/torberater/?wahl=${tbSlug(tbLabel(o))}`,
}));
---

<div class="max-w-5xl mx-auto">
  <p class="font-heading font-semibold text-white text-lg mb-4">Welches Tor suchst du?</p>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-left">
    {tiles.map((t) => (
      <a
        href={t.href}
        class="group flex flex-col overflow-hidden rounded-xl bg-white text-primary no-underline transition-transform duration-200 ease-out hover:-translate-y-1 active:scale-[0.98]"
      >
        {t.image && (
          <span class="block aspect-[4/3] overflow-hidden bg-neutral-100">
            <img
              src={t.image}
              alt=""
              width="480"
              height="360"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            />
          </span>
        )}
        <span class="flex flex-col gap-0.5 p-3 md:p-4">
          <span class="font-heading font-bold text-lg leading-tight text-primary group-hover:text-accent-dark transition-colors">{t.label}</span>
          {t.hint && <span class="text-sm text-neutral-500 leading-snug">{t.hint}</span>}
          <span class="text-sm font-semibold text-accent-dark mt-1">{t.meta}</span>
        </span>
      </a>
    ))}
  </div>
  <p class="mt-6 text-base text-white/80">
    Lieber erst lesen? <a href="/kaufberatung/" class="text-white font-semibold underline hover:text-accent-light">Zur Kaufberatung</a>
  </p>
</div>
