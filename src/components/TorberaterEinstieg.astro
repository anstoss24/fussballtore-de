---
/**
 * Einstieg in den Torberater für dunkle Flächen (Startseiten-Hero):
 * Frage 1 „Torgröße“ als Kacheln, ein Klick öffnet /torberater/ mit Vorauswahl.
 */
import { tbTree, tbLabel, tbSlug, tbMeta, tbImage } from '../utils/torberater';
import { HINTS } from '../data/torberater-texte';

const tiles = await Promise.all(
  tbTree.options.map(async (o) => ({
    label: tbLabel(o),
    hint: HINTS[`${tbTree.title}|${o.label}`],
    meta: tbMeta(o),
    image: await tbImage(o.image),
    href: `/torberater/?wahl=${tbSlug(tbLabel(o))}`,
  }))
);
---

<div class="max-w-4xl mx-auto">
  <p class="font-heading font-semibold text-white mb-4">Welches Tor suchst du?</p>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    {tiles.map((t) => (
      <a
        href={t.href}
        class="group flex flex-col items-center gap-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 hover:border-accent-light p-3 md:p-4 no-underline transition-colors"
      >
        {t.image && (
          <img
            src={t.image}
            alt=""
            width="96"
            height="96"
            decoding="async"
            class="w-16 h-16 md:w-20 md:h-20 rounded-full object-cover ring-2 ring-white/20 group-hover:ring-accent-light transition-all"
          />
        )}
        <span class="font-heading font-bold text-white text-base leading-tight">{t.label}</span>
        {t.hint && <span class="text-xs text-white/60 leading-tight -mt-1">{t.hint}</span>}
        <span class="text-xs text-white/50">{t.meta}</span>
      </a>
    ))}
  </div>
  <p class="mt-5 text-sm text-white/60">
    Lieber erst lesen? <a href="/kaufberatung/" class="text-white/90 hover:text-white underline underline-offset-2">Zur Kaufberatung</a>
  </p>
</div>
