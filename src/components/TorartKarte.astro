---
/**
 * Startseite „Fußballtore nach Torart“: Foto, Name, Maß, Kurzbeschreibung und Torberater-Kennzahl „x Tore · ab y €“.
 * Gleicher Kartenaufbau wie EinsatzortKarte.
 */
import { foto, type FotoKey } from '../utils/shop-image';

interface Props {
  name: string;
  href: string;
  mass: string;
  subtitle: string;
  bild: FotoKey;
  /** Torberater-Kennzahl „x Tore · ab y €“ */
  info?: string;
  /** Letzte Karte einer ungeraden Reihe: füllt im 2er-Raster die ganze Zeile */
  wide?: boolean;
  /** Erstes Bild im sichtbaren Bereich: nicht lazy laden */
  eager?: boolean;
}

const { name, href, mass, subtitle, bild, info, wide = false, eager = false } = Astro.props;
const b = foto(bild);
---

<a
  href={href}
  class:list={[
    wide && 'col-span-2 lg:col-span-1',
    'group flex h-full flex-col overflow-hidden rounded-xl bg-white no-underline ring-1 ring-neutral-200 transition-[box-shadow,transform] duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_12px_24px_-12px_rgba(15,23,42,0.25)] hover:ring-accent/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
  ]}
>
  <span class:list={['block overflow-hidden bg-neutral-100', wide ? 'aspect-[2/1] sm:aspect-[3/1] lg:aspect-[3/2]' : 'aspect-[3/2]']}>
    <img
      src={b.src}
      srcset={b.srcset}
      sizes={wide ? '(min-width: 1024px) 240px, 100vw' : '(min-width: 1024px) 240px, 50vw'}
      alt={b.alt}
      width="640"
      height="427"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
    />
  </span>
  <span class="flex flex-1 items-start justify-between gap-2 p-3 sm:p-4 md:p-5">
    <span class="flex h-full min-w-0 flex-col">
      <span class="block font-heading text-lg font-bold leading-snug text-primary group-hover:text-accent-dark transition-colors">{name}</span>
      <span class="mt-0.5 block text-sm font-semibold text-accent-dark" style="font-variant-numeric: tabular-nums">{mass}</span>
      <span class="mt-0.5 block text-sm leading-snug text-neutral-500">{subtitle}</span>
      {info && <span class="mt-auto block pt-2 text-sm font-medium text-neutral-600" style="font-variant-numeric: tabular-nums">{info}</span>}
    </span>
    <svg class="mt-1 h-5 w-5 flex-none text-neutral-400 transition-[transform,color] duration-200 ease-out group-hover:translate-x-1 group-hover:text-accent-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
    </svg>
  </span>
</a>
